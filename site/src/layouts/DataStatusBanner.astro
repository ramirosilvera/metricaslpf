---
// Antes: un banner grande y siempre visible con párrafos, barra de progreso y
// fila de chips en cada página. Ahora: una única insignia compacta y discreta
// que no compite con el análisis y despliega el mismo detalle real bajo demanda
// (fuentes, verificación cruzada, licencias, fechas) vía ConfidenceBadge.
import ConfidenceBadge from "./ConfidenceBadge.astro";
---

<div class="data-status">
  <ConfidenceBadge />
</div>

<style>
  .data-status {
    margin-bottom: 1.75rem;
  }
</style>
