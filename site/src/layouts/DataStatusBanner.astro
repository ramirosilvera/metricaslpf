---
import { loadJson, type Meta, type SourceStatus, type ConfidenceLevel } from "../lib/data";

const meta = loadJson<Meta>("meta.json");
const base = import.meta.env.BASE_URL;

// Etiquetas cortas por fuente para la fila de chips (nombre + proveedor real).
const LABELS: Record<string, string> = {
  physical_performance: "Físico (FIFA)",
  tactical_2026: "Táctico 2026 (FIFA)",
  tactical_context: "Contexto táctico (StatsBomb)",
  goal_events: "Goles (openfootball)",
  squad_ages: "Planteles (26worldcup/Wikipedia)",
  team_profile: "Ranking y campo base (26worldcup)",
  derived_metrics: "Métricas derivadas (cálculo propio)",
};

// El nivel de confianza NO es un score inventado: se deriva de la oficialidad
// de la fuente y de su cobertura real (ver meta.confidence_legend en el ETL).
const CONF_BADGE: Record<ConfidenceLevel, string> = {
  alta: "status-ok",
  media: "status-pending",
  complementaria: "conf-secondary",
  derivada: "conf-derived",
};
const CONF_LABEL: Record<ConfidenceLevel, string> = {
  alta: "Alta",
  media: "Media",
  complementaria: "Complementaria",
  derivada: "Derivada",
};

const order = [
  "physical_performance",
  "tactical_2026",
  "goal_events",
  "tactical_context",
  "squad_ages",
  "team_profile",
  "derived_metrics",
] as const;

const chips = order
  .map((key) => ({ key, s: (meta.sources as Record<string, SourceStatus>)[key] }))
  .filter((c) => c.s);

const phys = meta.sources.physical_performance;
const pct =
  phys.matches_total && phys.matches_total > 0
    ? Math.min(100, Math.round(((phys.matches_loaded ?? 0) / phys.matches_total) * 100))
    : null;

const cv = meta.cross_verification;
const fmtDate = (iso: string) =>
  new Date(iso).toLocaleString("es-AR", { dateStyle: "medium", timeStyle: "short" });
---

<div class="callout" style="margin-bottom: 1.75rem;">
  <h3>Estado y verificabilidad de los datos</h3>
  <p style="margin-bottom: 0.9rem;">
    Cada tabla indica fuente oficial, fecha de actualización, método y nivel de confianza.
    Actualización automática vía GitHub Actions. Última generación: <strong>{fmtDate(meta.generated_at)}</strong>.
  </p>

  {pct !== null && (
    <div style="margin-bottom: 0.85rem;">
      <div class="progress-row">
        <span class="badge status-ok"><span class="dot"></span>Físico (FIFA Training Centre)</span>
        <div class="progress-track"><div class="progress-fill" style={`width:${pct}%`}></div></div>
        <span class="progress-label">
          {phys.matches_loaded} / {phys.matches_total} partidos{phys.teams_total ? ` · ${phys.teams_loaded}/${phys.teams_total} selecciones` : ""}
        </span>
      </div>
    </div>
  )}

  {cv && cv.matches_checked > 0 && (
    <p class="cross-verify" style="margin-bottom: 0.85rem;">
      <span class="badge status-ok"><span class="dot"></span>Cruce de fuentes</span>
      <span>
        {cv.matches_matched}/{cv.matches_checked} partidos: los goles de openfootball (CC0) coinciden con el
        resultado oficial de FIFA Training Centre{cv.discrepancies === 0 ? ", 0 discrepancias" : `, ${cv.discrepancies} discrepancia(s)`}.
      </span>
    </p>
  )}

  <div style="display:flex; gap:0.5rem; flex-wrap:wrap; align-items:center;">
    {chips.map(({ key, s }) => {
      const conf = s.confidence ?? "media";
      const isOk = s.status === "ok";
      const cls = isOk ? CONF_BADGE[conf] : "status-pending";
      return (
        <span class={`badge ${cls}`} title={s.coverage_detail ?? s.coverage ?? ""}>
          <span class="dot"></span>
          {LABELS[key] ?? s.provider}
          {isOk ? ` · ${CONF_LABEL[conf]}` : " · pendiente"}
        </span>
      );
    })}
  </div>

  <p style="margin-top: 0.9rem; margin-bottom: 0; font-size: 0.85rem;">
    <a href={`${base}fuentes/`}>Ver fuentes, licencias, cobertura y método &rarr;</a>
  </p>
</div>

<style>
  .cross-verify {
    display: flex;
    gap: 0.55rem;
    align-items: flex-start;
    flex-wrap: wrap;
    font-size: 0.9rem;
  }
  .cross-verify span:last-child {
    flex: 1;
    min-width: 220px;
  }
  /* Colores de confianza reutilizando el sistema de badges existente.
     Complementaria y derivada usan tonos neutros (no verde/ámbar) para no
     sugerir un semáforo de calidad donde no lo hay. */
  .badge.conf-secondary {
    color: var(--text-secondary);
    background: var(--surface-2);
    border-color: var(--border);
  }
  .badge.conf-secondary .dot {
    background: var(--text-secondary);
  }
  .badge.conf-derived {
    color: color-mix(in srgb, var(--brand) 70%, var(--text-primary));
    background: color-mix(in srgb, var(--brand) 10%, var(--surface-2));
    border-color: color-mix(in srgb, var(--brand) 25%, var(--border));
  }
  .badge.conf-derived .dot {
    background: var(--brand);
  }
</style>
