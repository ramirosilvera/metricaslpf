---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Matiz — tu estilista que te explica por qué combina." } = Astro.props;
const path = Astro.url.pathname;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title} · Matiz</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#c8763f" />
    <!-- iOS 16.4+ ya honra display:standalone del manifest -- estos tags son
         compatibilidad para versiones previas y para fijar explícitamente el
         estilo de status bar. "default" (no black-translucent): con
         black-translucent la status bar dibuja sus glifos (hora, batería,
         señal) SIEMPRE en blanco, y la paleta de esta app es clara y sin modo
         oscuro (--bg: #fbf7f2) -- quedarían ilegibles. Con "default" iOS
         reserva la barra como opaca y empuja el contenido debajo solo. -->
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="Matiz" />
    <link rel="manifest" href={`${import.meta.env.BASE_URL}manifest.webmanifest`} />
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon-32.png`} />
    <link rel="apple-touch-icon" href={`${import.meta.env.BASE_URL}apple-touch-icon.png`} />
  </head>
  <body>
    <slot />
    <nav class="tabbar">
      <a
        href={import.meta.env.BASE_URL}
        class={path === import.meta.env.BASE_URL || path.includes("/combinar/") ? "active" : ""}
      >
        Placard
      </a>
      <a href={`${import.meta.env.BASE_URL}prenda/nueva/`} class={path.includes("/prenda/") ? "active" : ""}>+ Prenda</a>
      <a href={`${import.meta.env.BASE_URL}probar/`} class={path.includes("/probar/") ? "active" : ""}>Probar</a>
      <a href={`${import.meta.env.BASE_URL}outfits/`} class={path.includes("/outfits/") ? "active" : ""}>Outfits</a>
    </nav>
    <script>
      if ("serviceWorker" in navigator) {
        navigator.serviceWorker.register(`${import.meta.env.BASE_URL}sw.js`).catch(() => {});
      }
    </script>
  </body>
</html>
