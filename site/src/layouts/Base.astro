---
import "../styles/global.css";
import ChatAssistant from "../islands/ChatAssistant";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Análisis abierto del rendimiento físico y táctico en el Mundial 2026." } = Astro.props;
const base = import.meta.env.BASE_URL;

const fullTitle = `${title} · Métricas Mundial 2026`;
// En build estático Astro.url ya refleja site + base (astro.config.mjs), así que
// la URL canónica se arma contra el origin conocido de GitHub Pages.
const canonicalUrl = new URL(Astro.url.pathname, "https://ramirosilvera.github.io").href;

const navItems = [
  { href: `${base}`, label: "Inicio" },
  { href: `${base}selecciones/`, label: "Selecciones" },
  { href: `${base}comparar/`, label: "Comparar" },
  { href: `${base}jugadores/`, label: "Jugadores" },
  { href: `${base}goleadores/`, label: "Goleadores" },
  { href: `${base}analisis/`, label: "Análisis" },
  { href: `${base}explorador/`, label: "Explorador" },
  { href: `${base}metodologia/`, label: "Metodología" },
  { href: `${base}fuentes/`, label: "Fuentes" },
];

const currentPath = Astro.url.pathname;
function isActive(href: string) {
  if (href === base) return currentPath === base || currentPath === `${base}index.html`;
  return currentPath.startsWith(href);
}
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title} · Métricas Mundial 2026</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content="es_AR" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>⚽</text></svg>" />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href={`${base}`}>
          <span class="brand-mark">⚽</span>
          <span class="brand-text">
            <strong>Métricas Mundial 2026</strong>
            <span>análisis físico y táctico · 100% datos abiertos</span>
          </span>
        </a>

        <input type="checkbox" id="nav-toggle" class="nav-toggle" />
        <label for="nav-toggle" class="nav-toggle-label" aria-label="Abrir menú">
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M3 5H17M3 10H17M3 15H17" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
          </svg>
        </label>

        <nav class="nav">
          {navItems.map((item) => (
            <a href={item.href} aria-current={isActive(item.href) ? "page" : undefined}>
              {item.label}
            </a>
          ))}
        </nav>
      </div>
    </header>
    <main>
      <div class="wrap">
        <slot />
      </div>
    </main>
    <footer class="footer">
      <div class="wrap">
        <p>
          Proyecto abierto, sin fines de lucro. Código y datos versionados en <a href="https://github.com/ramirosilvera/metricasmundial2026" target="_blank" rel="noreferrer">GitHub</a>.
          Fuentes: FIFA Training Centre, StatsBomb Open Data, openfootball (CC0) y 26worldcup/Wikipedia. Ver <a href={`${base}fuentes/`}>fuentes</a> y <a href={`${base}metodologia/`}>metodología</a> para
          licencias, cobertura, limitaciones y sesgos conocidos.
        </p>
      </div>
    </footer>
    <ChatAssistant client:only="react" />
  </body>
</html>
