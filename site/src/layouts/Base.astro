---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Matiz — tu estilista que te explica por qué combina." } = Astro.props;
const path = Astro.url.pathname;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title} · Matiz</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#c8763f" />
    <!-- iOS 16.4+ ya honra display:standalone del manifest -- estos tags son
         compatibilidad para versiones previas y para fijar explícitamente el
         estilo de status bar. "default" (no black-translucent): con
         black-translucent la status bar dibuja sus glifos (hora, batería,
         señal) SIEMPRE en blanco, y la paleta de esta app es clara y sin modo
         oscuro (--bg: #fbf7f2) -- quedarían ilegibles. Con "default" iOS
         reserva la barra como opaca y empuja el contenido debajo solo. -->
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="Matiz" />
    <link rel="manifest" href={`${import.meta.env.BASE_URL}manifest.webmanifest`} />
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon-32.png`} />
    <link rel="apple-touch-icon" href={`${import.meta.env.BASE_URL}apple-touch-icon.png`} />
  </head>
  <body>
    <slot />
    <div id="matiz-update-banner" class="update-banner" hidden>
      <span>Hay una versión nueva de Matiz.</span>
      <button type="button" onclick="location.reload()">Actualizar</button>
    </div>
    <nav class="tabbar">
      <a
        href={import.meta.env.BASE_URL}
        class={path === import.meta.env.BASE_URL || path.includes("/combinar/") ? "active" : ""}
      >
        Placard
      </a>
      <a href={`${import.meta.env.BASE_URL}prenda/nueva/`} class={path.includes("/prenda/") ? "active" : ""}>+ Prenda</a>
      <a href={`${import.meta.env.BASE_URL}probar/`} class={path.includes("/probar/") ? "active" : ""}>Probar</a>
      <a href={`${import.meta.env.BASE_URL}outfits/`} class={path.includes("/outfits/") ? "active" : ""}>Outfits</a>
    </nav>
    <script>
      if ("serviceWorker" in navigator) {
        // sw.js llama a skipWaiting()+clients.claim() sin pedir permiso, así
        // que un service worker nuevo toma control de la pestaña ya abierta
        // solo -- pero el HTML/JS que está en memoria en ESE momento sigue
        // siendo el viejo hasta recargar. Es justo el bug reportado: una app
        // ya abierta (o una PWA instalada que no se cerró del todo) se queda
        // corriendo la versión de antes de un deploy y una feature nueva
        // (como el botón de eliminar prenda) no aparece hasta refrescar.
        // "controllerchange" avisa de eso; no se recarga sola para no
        // interrumpir algo que el usuario esté completando (ej. el form de
        // cargar una prenda).
        const teniaControlador = Boolean(navigator.serviceWorker.controller);
        navigator.serviceWorker.addEventListener("controllerchange", () => {
          if (!teniaControlador) return; // primera instalación, no una actualización real
          const banner = document.getElementById("matiz-update-banner");
          if (!banner) return;
          banner.hidden = false;
          // el body necesita el mismo espacio reservado arriba que el
          // banner, si no tapa el título de la pantalla (ver .update-banner
          // y body.tiene-aviso-actualizacion en global.css).
          document.body.classList.add("tiene-aviso-actualizacion");
        });
        navigator.serviceWorker.register(`${import.meta.env.BASE_URL}sw.js`).then((reg) => {
          // el chequeo automático del navegador no es predecible en todos
          // los contextos (PWA standalone en background, etc.) -- forzar un
          // chequeo cuando la pestaña vuelve a primer plano es lo que más
          // ataca el escenario real: la app quedó abierta desde antes de un
          // deploy y no se refrescó sola.
          document.addEventListener("visibilitychange", () => {
            if (document.visibilityState === "visible") reg.update().catch(() => {});
          });
        }).catch(() => {});
      }
    </script>
  </body>
</html>
