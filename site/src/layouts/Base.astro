---
import "../styles/global.css";
import ChatAssistant from "../islands/ChatAssistant";

interface Props {
  title: string;
  description?: string;
  /** Imagen Open Graph opcional (URL absoluta). Por defecto la tarjeta de marca. */
  image?: string;
}

const { title, description = "Análisis abierto del rendimiento físico y táctico en el Mundial 2026.", image } = Astro.props;
const base = import.meta.env.BASE_URL;
const origin = "https://ramirosilvera.github.io";

const fullTitle = `${title} · Métricas Mundial 2026`;
// En build estático Astro.url ya refleja site + base (astro.config.mjs), así que
// la URL canónica se arma contra el origin conocido de GitHub Pages.
const canonicalUrl = new URL(Astro.url.pathname, origin).href;
// Imagen social por defecto (tarjeta de marca 1200x630 en /public).
const ogImage = image ?? new URL(`${base}og-image.png`, origin).href;

// Navegación centrada en preguntas, no en categorías: 5 ítems primarios
// (Inicio · Comparar · Rankings · Analizar · IA). "Rankings" agrupa las tres
// páginas de ranking existentes; "Más" agrupa lo secundario (Explorador,
// Metodología, Fuentes) sin quitarlo de la navegación. Ninguna URL cambia.
const currentPath = Astro.url.pathname;
function isActive(href: string) {
  if (href === base) return currentPath === base || currentPath === `${base}index.html`;
  return currentPath.startsWith(href);
}

const homeItem = { href: `${base}`, label: "Inicio" };
const compararItem = { href: `${base}comparar/`, label: "Comparar" };
const analizarItem = { href: `${base}analisis/`, label: "Analizar" };

const rankingsItems = [
  { href: `${base}selecciones/`, label: "Selecciones" },
  { href: `${base}jugadores/`, label: "Jugadores" },
  { href: `${base}goleadores/`, label: "Goleadores" },
];
const secondaryItems = [
  { href: `${base}explorador/`, label: "Laboratorio" },
  { href: `${base}metodologia/`, label: "Metodología" },
  { href: `${base}fuentes/`, label: "Fuentes" },
];

const rankingsActive = rankingsItems.some((i) => isActive(i.href));
const secondaryActive = secondaryItems.some((i) => isActive(i.href));
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title} · Métricas Mundial 2026</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="theme-color" content="#15a94f" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#060d09" media="(prefers-color-scheme: dark)" />

    <meta property="og:site_name" content="Métricas Mundial 2026" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Métricas Mundial 2026 — análisis físico y táctico con datos abiertos" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><rect width=%22100%22 height=%22100%22 rx=%2224%22 fill=%22%2315a94f%22/><g stroke=%22white%22 stroke-width=%226%22 fill=%22none%22 stroke-linecap=%22round%22 stroke-linejoin=%22round%22><circle cx=%2250%22 cy=%2252%22 r=%2230%22/><path d=%22M50 40 L62.4 48 L57.6 62.5 L42.4 62.5 L37.6 48 Z%22 fill=%22white%22 stroke=%22none%22/><path d=%22M50 40 V22 M62.4 48 L78.5 42.7 M57.6 62.5 L67.6 76.3 M42.4 62.5 L32.4 76.3 M37.6 48 L21.5 42.7%22/></g></svg>" />
    <link rel="icon" type="image/png" sizes="32x32" href={`${base}favicon-32.png`} />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
    <link rel="manifest" href={`${base}manifest.webmanifest`} />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Métricas M26" />
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href={`${base}`}>
          <span class="brand-mark" aria-hidden="true">
            <svg width="21" height="21" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.6" />
              <path d="M12 8.8 L15.04 11.01 L13.88 14.59 L10.12 14.59 L8.96 11.01 Z" fill="currentColor" />
              <path
                d="M12 8.8 V3 M15.04 11.01 L20.6 9.2 M13.88 14.59 L17.3 19.3 M10.12 14.59 L6.7 19.3 M8.96 11.01 L3.4 9.2"
                stroke="currentColor"
                stroke-width="1.4"
                stroke-linecap="round"
              />
            </svg>
          </span>
          <span class="brand-text">
            <strong>Métricas Mundial 2026</strong>
            <span>análisis físico y táctico · 100% datos abiertos</span>
          </span>
        </a>

        <input type="checkbox" id="nav-toggle" class="nav-toggle" aria-label="Abrir menú de navegación" aria-controls="nav-principal" />
        <label for="nav-toggle" class="nav-toggle-label" aria-hidden="true">
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M3 5H17M3 10H17M3 15H17" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
          </svg>
        </label>

        <nav class="nav" id="nav-principal" aria-label="Navegación principal">
          <a href={homeItem.href} aria-current={isActive(homeItem.href) ? "page" : undefined}>{homeItem.label}</a>
          <a href={compararItem.href} aria-current={isActive(compararItem.href) ? "page" : undefined}>{compararItem.label}</a>

          <details class="nav-group">
            <summary class={rankingsActive ? "is-active" : undefined} aria-current={rankingsActive ? "page" : undefined}>Rankings</summary>
            <div class="nav-dropdown">
              {rankingsItems.map((item) => (
                <a href={item.href} aria-current={isActive(item.href) ? "page" : undefined}>{item.label}</a>
              ))}
            </div>
          </details>

          <a href={analizarItem.href} aria-current={isActive(analizarItem.href) ? "page" : undefined}>{analizarItem.label}</a>

          <button type="button" class="nav-ia" data-open-chat aria-haspopup="dialog">IA</button>

          <details class="nav-group nav-group-more">
            <summary class={secondaryActive ? "is-active" : undefined} aria-current={secondaryActive ? "page" : undefined}>Más</summary>
            <div class="nav-dropdown">
              {secondaryItems.map((item) => (
                <a href={item.href} aria-current={isActive(item.href) ? "page" : undefined}>{item.label}</a>
              ))}
            </div>
          </details>
        </nav>
      </div>
    </header>
    <main id="contenido">
      <div class="wrap">
        <slot />
      </div>
    </main>
    <footer class="footer">
      <div class="wrap">
        <p>
          Proyecto abierto, sin fines de lucro. Código y datos versionados en <a href="https://github.com/ramirosilvera/metricasmundial2026" target="_blank" rel="noreferrer">GitHub</a>.
          Fuentes: FIFA Training Centre, StatsBomb Open Data, openfootball (CC0) y 26worldcup/Wikipedia. Ver <a href={`${base}fuentes/`}>fuentes</a> y <a href={`${base}metodologia/`}>metodología</a> para
          licencias, cobertura, limitaciones y sesgos conocidos.
        </p>
      </div>
    </footer>
    <ChatAssistant client:only="react" />
    <script is:inline>
      // El ítem "IA" del menú no navega: abre el asistente flotante (ChatAssistant).
      // Delegamos el click y emitimos un CustomEvent global; el listener vive en
      // ChatAssistant (lo agrega el agente dueño de esa isla). Si todavía no hay
      // listener (o el chat no está configurado), el click es inofensivo.
      document.addEventListener("click", (e) => {
        const trigger = e.target instanceof Element ? e.target.closest("[data-open-chat]") : null;
        if (!trigger) return;
        e.preventDefault();
        window.dispatchEvent(new CustomEvent("mm26:open-chat"));
      });
    </script>
    <script is:inline define:vars={{ swUrl: `${base}sw.js`, swScope: base }}>
      // Registro del service worker (PWA + app shell offline). Conservador: si
      // falla, el sitio funciona igual. Ver comentarios en public/sw.js.
      if ("serviceWorker" in navigator) {
        window.addEventListener("load", () => {
          navigator.serviceWorker.register(swUrl, { scope: swScope }).catch(() => {});
        });
      }
    </script>
  </body>
</html>
