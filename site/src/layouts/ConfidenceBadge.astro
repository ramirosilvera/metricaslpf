---
// Insignia de confianza reutilizable y compacta.
//
// Dos modos, ambos leen SIEMPRE de meta.json (nada inventado):
//   - Agregado (sin prop `source`): resume la verificabilidad de todo el
//     dataset. Muestra "✓ Datos verificados" y, al desplegar, la consistencia
//     interna real (goles evento a evento vs. marcador final, ambos de ESPN)
//     + una fila por fuente con su nivel de confianza, cobertura, licencia y
//     fecha, más el enlace al registro completo (/fuentes/).
//   - Individual (`source="physical_performance"`): sella un dato concreto con
//     una etiqueta acorde a su confianza real y despliega su ficha (proveedor,
//     licencia, cobertura, método, fecha).
//
// El nivel de confianza NO es un score inventado: viene tal cual de meta.json
// (derivado en el ETL de la oficialidad de la fuente y su cobertura).
import { loadJson, type Meta, type SourceStatus, type ConfidenceLevel } from "../lib/data";

interface Props {
  /** Clave de meta.sources para el modo individual. Si se omite, modo agregado. */
  source?: keyof Meta["sources"];
  /** Texto de la pastilla en modo individual; por defecto según la confianza. */
  label?: string;
}

const { source, label } = Astro.props as Props;
const meta = loadJson<Meta>("meta.json");
const base = import.meta.env.BASE_URL;

const LABELS: Record<string, string> = {
  physical_performance: "Físico/GPS (no disponible)",
  tactical_context: "Estadística de equipo (ESPN)",
  player_match_stats: "Estadística de jugador por partido (no disponible)",
  player_season_stats: "Estadística de jugador por temporada (FotMob)",
  goal_events: "Goles (ESPN)",
  squad_ages: "Planteles (ESPN)",
  team_profile: "Clubes (ESPN)",
  standings: "Tabla de posiciones (ESPN)",
  derived_metrics: "Métricas derivadas (cálculo propio)",
};

const CONF_LABEL: Record<ConfidenceLevel, string> = {
  alta: "Alta",
  media: "Media",
  complementaria: "Complementaria",
  derivada: "Derivada",
};

// Etiqueta honesta de la pastilla individual según la confianza real.
const SUMMARY_BY_CONF: Record<ConfidenceLevel, string> = {
  alta: "Dato oficial",
  media: "Fuente verificada",
  complementaria: "Fuente complementaria",
  derivada: "Métrica derivada",
};

const order: (keyof Meta["sources"])[] = [
  "standings",
  "tactical_context",
  "goal_events",
  "squad_ages",
  "team_profile",
  "player_season_stats",
  "player_match_stats",
  "physical_performance",
  "derived_metrics",
];

const fmtDate = (iso?: string) =>
  iso ? new Date(iso).toLocaleString("es-AR", { dateStyle: "medium" }) : "";

// Una fuente se considera "sellada con check" (verde) si es oficial o
// verificada; complementaria/derivada van en tono neutro.
const isOfficial = (c?: ConfidenceLevel) => c === "alta" || c === "media";

// "✓ Datos verificados" no puede depender solo de la confianza declarada de
// la fuente -- una fuente "alta" que no se actualiza hace semanas (ej. ESPN
// bloqueado con 403, ver etl/fetch_espn_lpf.py) seguía mostrando el mismo
// check verde que una recién actualizada, porque as_of nunca se comparaba
// contra la fecha real. Acá se calcula en build time contra meta.generated_at
// (la corrida que generó este mismo meta.json), no contra Date.now() del
// navegador -- el sitio es estático, así que "ahora" para esta página es el
// momento en que se publicó.
const STALE_THRESHOLD_MS = 72 * 60 * 60 * 1000; // 72h -- el pipeline corre cada 6h
const buildNow = Date.parse(meta.generated_at);
const isStale = (s?: SourceStatus | null) => {
  if (!s || !s.as_of || s.status !== "ok" || !isOfficial(s.confidence)) return false;
  const t = Date.parse(s.as_of);
  return Number.isFinite(t) && Number.isFinite(buildNow) && buildNow - t > STALE_THRESHOLD_MS;
};

const cv = meta.cross_verification;

const aggSources = order
  .map((key) => ({ key, s: (meta.sources as Record<string, SourceStatus>)[key] }))
  .filter((c) => c.s);
const staleSources = aggSources.filter(({ s }) => isStale(s));

const singleSrc = source ? (meta.sources as Record<string, SourceStatus>)[source] : null;
const singleConf: ConfidenceLevel = singleSrc?.confidence ?? "media";
const singleStale = source ? isStale(singleSrc) : false;
const muted = source ? !isOfficial(singleConf) : false;
const summaryLabel = source
  ? singleStale
    ? "Desactualizado"
    : (label ?? SUMMARY_BY_CONF[singleConf])
  : staleSources.length > 0
    ? "Puede haber datos desactualizados"
    : "Datos verificados";
const showCheck = source ? isOfficial(singleConf) && !singleStale : staleSources.length === 0;
const stale = source ? singleStale : staleSources.length > 0;
---

<details class={`confidence-badge${muted ? " is-muted" : ""}${stale ? " is-stale" : ""}`}>
  <summary>
    {showCheck ? (
      <span class="cb-check" aria-hidden="true">✓</span>
    ) : (
      <span class="cb-warn" aria-hidden="true">⚠</span>
    )}
    <span>{summaryLabel}</span>
    <span class="cb-caret" aria-hidden="true">▾</span>
  </summary>

  {source && singleSrc ? (
    <div class="confidence-panel">
      <p><strong>{LABELS[source as string] ?? singleSrc.provider}</strong> · confianza {CONF_LABEL[singleConf].toLowerCase()}</p>
      {singleSrc.coverage_detail && <p class="cb-src-meta">Cobertura: {singleSrc.coverage_detail}</p>}
      {singleSrc.method && <p class="cb-src-meta">Método: {singleSrc.method}</p>}
      {(singleSrc.license_short ?? singleSrc.license) && (
        <p class="cb-src-meta">Licencia: {singleSrc.license_short ?? singleSrc.license}</p>
      )}
      {singleSrc.as_of && <p class="cb-src-meta">Actualizado: {fmtDate(singleSrc.as_of)}</p>}
      {singleStale && (
        <p class="cb-stale-warning">
          ⚠ Esta fuente lleva más de 3 días sin actualizarse -- puede no reflejar lo último. Ver detalle en /fuentes/.
        </p>
      )}
      <a class="cb-more" href={`${base}fuentes/`}>Ver registro completo de fuentes &rarr;</a>
    </div>
  ) : (
    <div class="confidence-panel">
      <p>
        Cada tabla se genera de fuentes con licencia y fecha trazables.
        Última actualización automática: <strong>{fmtDate(meta.generated_at)}</strong>.
      </p>
      {staleSources.length > 0 && (
        <p class="cb-stale-warning">
          ⚠ {staleSources.map(({ key, s }) => `${LABELS[key as string] ?? key} (desde ${fmtDate(s.as_of)})`).join(", ")}{" "}
          {staleSources.length === 1 ? "lleva" : "llevan"} más de 3 días sin actualizarse -- el resto de las fuentes sí está al día. Ver /fuentes/ para el detalle y la causa.
        </p>
      )}
      {cv && cv.matches_checked > 0 && (
        <p class="cb-cross">
          ✓ {cv.matches_matched}/{cv.matches_checked} partidos con goles consistentes con el marcador final
          {cv.discrepancies === 0 ? " · 0 discrepancias" : ` · ${cv.discrepancies} discrepancia(s)`}.
        </p>
      )}
      <ul class="cb-sources">
        {aggSources.map(({ key, s }) => (
          <li class={`cb-source${isStale(s) ? " is-stale" : ""}`}>
            <span><strong>{LABELS[key as string] ?? s.provider}</strong> · {CONF_LABEL[s.confidence ?? "media"].toLowerCase()}</span>
            <span class="cb-src-meta">
              {s.coverage_detail ?? s.coverage ?? ""}
              {s.as_of ? ` · ${fmtDate(s.as_of)}` : ""}
              {isStale(s) ? " · ⚠ desactualizado" : ""}
            </span>
          </li>
        ))}
      </ul>
      <a class="cb-more" href={`${base}fuentes/`}>Ver fuentes, licencias, cobertura y método &rarr;</a>
    </div>
  )}
</details>
