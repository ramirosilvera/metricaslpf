---
import Base from "../layouts/Base.astro";
import DataStatusBanner from "../layouts/DataStatusBanner.astro";
import TeamMetricsRadar from "../islands/TeamMetricsRadar";
import PlayerScoutCard, { type SquadInfo } from "../islands/PlayerScoutCard";
import SquadDepthChart from "../islands/SquadDepthChart";
import {
  loadJson,
  type DerivedTeamMetricRow,
  type DerivedTeamStyleRow,
  type DerivedPlayerMetricRow,
  type SquadPlayerRow,
} from "../lib/data";

function loadArray<T>(filename: string): T[] {
  const raw = loadJson<T[] | { status: string; rows: [] }>(filename);
  return Array.isArray(raw) ? raw : [];
}

const teamMetrics = loadArray<DerivedTeamMetricRow>("derived_team_metrics.json");
const teamStyle = loadArray<DerivedTeamStyleRow>("derived_team_style.json");
const playerMetrics = loadArray<DerivedPlayerMetricRow>("derived_player_metrics.json");
const squadRows = loadArray<SquadPlayerRow>("squads.json");

// Las métricas derivadas usan el nombre estilo FIFA ("Amine GOUIRI") y el
// plantel el nombre editorial ("Amine Gouiri"), así que el cruce se hace en
// build normalizando mayúsculas y diacríticos. Es un match best-effort: si un
// jugador no cruza, la ficha simplemente no muestra datos de plantel.
function normName(name: string): string {
  return name
    .normalize("NFD")
    .replace(/\p{M}/gu, "")
    .replace(/ø/gi, "o")
    .replace(/đ/gi, "d")
    .replace(/ł/gi, "l")
    .toLowerCase()
    .split(/\s+/)
    .join(" ")
    .trim();
}

const squadByNorm = new Map(squadRows.map((r) => [`${r.team}|${normName(r.player_name)}`, r]));
const squadInfo: Record<string, SquadInfo> = {};
for (const row of playerMetrics) {
  const key = `${row.team}|${row.player_name}`;
  if (key in squadInfo) continue;
  const sq = squadByNorm.get(`${row.team}|${normName(row.player_name)}`);
  if (sq) {
    squadInfo[key] = {
      jersey_number: sq.jersey_number,
      position: sq.position,
      club: sq.club,
      caps: sq.caps,
      captain: sq.captain,
      wc2026_apps: sq.wc2026_apps,
      wc2026_goals: sq.wc2026_goals,
    };
  }
}

const styleGroups = teamStyle.reduce<Record<string, DerivedTeamStyleRow[]>>((acc, row) => {
  (acc[row.cluster_label] ??= []).push(row);
  return acc;
}, {});
---

<Base
  title="Análisis avanzado"
  description="Percentiles, z-scores y estilo de juego por selección y jugador — el mismo tipo de lectura que usa un analista de video."
>
  <DataStatusBanner />
  <p class="eyebrow">Scouting report</p>
  <h1>Análisis avanzado</h1>
  <p class="lede">
    Percentiles y z-scores calculados sobre los datos ya cargados (no un ranking mundial completo), un clustering
    simple de estilo de juego, y una ficha de jugador que combina físico y táctico — pensado para leerse como el
    reporte de un analista de video, no solo como una tabla más.
  </p>

  <section class="section">
    <div class="section-head">
      <h2>Radar cabeza a cabeza (todas las fuentes)</h2>
      <p>Combina táctico, físico y plantel en un mismo radar cuando hay datos de las tres fuentes.</p>
    </div>
    <div class="card">
      <TeamMetricsRadar client:only="react" rows={teamMetrics} />
    </div>
  </section>

  <section class="section">
    <div class="section-head">
      <h2>Estilo de juego</h2>
      <p>
        Clustering (k-means) sobre 5 métricas tácticas estandarizadas — agrupa selecciones con perfiles parecidos, no
        es una etiqueta táctica validada. Ver <a href="../metodologia/">metodología</a>.
      </p>
    </div>
    {
      Object.keys(styleGroups).length === 0 ? (
        <p class="card" style="color: var(--text-muted)">
          Todavía no hay suficientes datos tácticos cargados para agrupar estilos.
        </p>
      ) : (
        <div class="style-grid">
          {Object.entries(styleGroups).map(([label, teams]) => (
            <div class="card style-card">
              <h3>{label}</h3>
              <ul>
                {teams.map((t) => (
                  <li>
                    {t.team} <span class="badge">{t.season}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      )
    }
  </section>

  {squadRows.length > 0 && (
    <section class="section">
      <div class="section-head">
        <h2>Perfil de plantel: edad y experiencia</h2>
        <p>
          ¿Es un plantel joven o veterano? ¿Dónde está concentrada la experiencia? Cada punto es un jugador — edad
          contra caps/goles, por posición. Datos reales del plantel actual de las 48 selecciones.
        </p>
      </div>
      <div class="card">
        <SquadDepthChart client:only="react" rows={squadRows} />
      </div>
    </section>
  )}

  <section class="section">
    <div class="section-head">
      <h2>Ficha de jugador</h2>
      <p>Percentil en cada métrica disponible (física y táctica) dentro del propio dataset.</p>
    </div>
    <div class="card">
      <PlayerScoutCard client:only="react" rows={playerMetrics} squad={squadInfo} />
    </div>
  </section>
</Base>

<style>
  .style-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1rem;
  }
  .style-card h3 {
    margin-top: 0;
    font-size: 1rem;
  }
  .style-card ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .style-card li {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.9rem;
    color: var(--text-secondary);
  }
</style>
