---
import Base from "../layouts/Base.astro";
import DataStatusBanner from "../layouts/DataStatusBanner.astro";
import PlayerScoutCard, { type SquadInfo } from "../islands/PlayerScoutCard";
import SquadDepthChart from "../islands/SquadDepthChart";
import { loadJson, loadCrestMap, type DerivedPlayerMetricRow, type SquadPlayerRow } from "../lib/data";
import { normName, TEAM_ALIAS_FOTMOB_TO_ESPN } from "../lib/playerPositions";

const base = import.meta.env.BASE_URL;
const crests = loadCrestMap();

function loadArray<T>(filename: string): T[] {
  const raw = loadJson<T[] | { status: string; rows: [] }>(filename);
  return Array.isArray(raw) ? raw : [];
}

const playerMetrics = loadArray<DerivedPlayerMetricRow>("derived_player_metrics.json");
const squadRows = loadArray<SquadPlayerRow>("squads.json");

// Minutos jugados en la temporada (FotMob, metric="mins_played") por
// jugador -- único dato real de "rodaje" disponible para LPF (ESPN no
// publica caps ni partidos de club). Se cruza por nombre normalizado, mismo
// criterio que buildPlayerPositions.
// FotMob (playerMetrics) y ESPN (squadRows) usan nombre de club distinto
// para 6 de los 30 clubes -- mismo alias que arregla el cruce de posición
// del índice global (ver lib/playerPositions.ts), acá también hace falta
// para que "Perfil de plantel" y "Ficha de jugador" no dejen a esos 6
// clubes sin minutos/dorsal/posición.
const minutesByPlayer: Record<string, number> = {};
for (const r of playerMetrics) {
  if (r.metric !== "mins_played" || r.value == null) continue;
  const espnTeam = TEAM_ALIAS_FOTMOB_TO_ESPN[r.team] ?? r.team;
  minutesByPlayer[`${espnTeam}|${normName(r.player_name)}`] = r.value;
}

const squadByNorm = new Map(squadRows.map((r) => [`${r.team}|${normName(r.player_name)}`, r]));
const squadInfo: Record<string, SquadInfo> = {};
for (const row of playerMetrics) {
  const key = `${row.team}|${row.player_name}`;
  if (key in squadInfo) continue;
  const espnTeam = TEAM_ALIAS_FOTMOB_TO_ESPN[row.team] ?? row.team;
  const sq = squadByNorm.get(`${espnTeam}|${normName(row.player_name)}`);
  if (sq) {
    squadInfo[key] = {
      jersey_number: sq.jersey_number,
      position: sq.position,
      club: sq.club,
      caps: sq.caps,
      captain: sq.captain,
      wc2026_apps: sq.wc2026_apps,
      wc2026_goals: sq.wc2026_goals,
    };
  }
}
---

<Base
  title="Análisis avanzado"
  description="Perfil de plantel y ficha de jugador de la Liga Profesional Argentina, con índice de rendimiento sobre las categorías reales de FotMob."
>
  <DataStatusBanner />
  <p class="eyebrow">La lupa · un caso a la vez</p>
  <h1>Analizar en profundidad</h1>
  <p class="lede">
    Ni tabla ni duelo: acá entrás en <strong>un</strong> caso puntual y cruzás sus datos. El perfil del plantel de un
    club y la ficha de un jugador — pensado para leerse como el reporte de un analista. <em>Para ordenar a todos usá
    Rankings; para enfrentar dos, <a href={`${base}comparar/`}>Comparar</a>.</em>
  </p>

  {squadRows.length > 0 && (
    <section class="section">
      <div class="section-head">
        <h2>Perfil de plantel: edad y minutos jugados</h2>
        <p>
          ¿Es un plantel joven o veterano? ¿Quién acumula más rodaje? Cada punto es un jugador — edad contra minutos
          jugados en la temporada, por posición. Plantel real de los 30 clubes de la Liga Profesional.
        </p>
      </div>
      <div class="card">
        <SquadDepthChart client:only="react" rows={squadRows} minutesByPlayer={minutesByPlayer} />
      </div>
    </section>
  )}

  <section class="section">
    <div class="section-head">
      <h2>Ficha de jugador</h2>
      <p>
        Índice de rendimiento en cada categoría de FotMob que el jugador tenga cargada, con un <strong>GLOBAL
        ponderado por su posición</strong>, estilo EA SPORTS FC. <em>¿Querés enfrentar dos jugadores? Está en <a href={`${base}comparar/`}>Comparar</a>.</em>
      </p>
    </div>
    <div class="card">
      <PlayerScoutCard client:only="react" rows={playerMetrics} squad={squadInfo} crests={crests} />
    </div>
  </section>
</Base>
