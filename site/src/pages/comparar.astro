---
import Base from "../layouts/Base.astro";
import DataStatusBanner from "../layouts/DataStatusBanner.astro";
import RadarCompare from "../islands/RadarCompare";
import TimelineChart from "../islands/TimelineChart";
import { loadJson, type RadarRow, type TimelineRow, type TeamPhysicalRankingRow, type TeamTacticalRankingRow } from "../lib/data";

// Normaliza el shape {status, rows} de los agregados que aún no se scrapearon
// a un array vacío, para que el radar arranque en un modo con datos.
function loadArray<T>(filename: string): T[] {
  const raw = loadJson<T[] | { status: string; rows: [] }>(filename);
  return Array.isArray(raw) ? raw : [];
}

const radar = loadJson<RadarRow[]>("radar_team_season.json");
const teamPhysical = loadArray<TeamPhysicalRankingRow>("team_physical_ranking.json");
const teamTactical = loadArray<TeamTacticalRankingRow>("team_tactical_ranking.json");
const timeline = loadJson<TimelineRow[]>("timeline_tactical.json");
---

<Base title="Comparar" description="Comparación cabeza a cabeza y evolución dentro del torneo.">
  <DataStatusBanner />
  <p class="eyebrow">Cara a cara · dos selecciones</p>
  <h1>Comparar</h1>
  <p class="lede">
    El modo <strong>uno contra uno</strong>: elegí <strong>dos</strong> selecciones y miralas lado a lado en un radar,
    con una lectura automática de las diferencias que más pesan. Físico o táctico del Mundial 2026, o el histórico
    2018/2022. <em>¿Querés ver a las 48 ordenadas en una tabla? Eso está en Rankings.</em>
  </p>

  <section class="section">
    <div class="card">
      <RadarCompare client:only="react" rows={radar} physicalRows={teamPhysical} tacticalRows={teamTactical} />
    </div>
  </section>

  <section class="section">
    <div class="section-head"><h2>Evolución durante el torneo</h2></div>
    <div class="card">
      <TimelineChart client:only="react" rows={timeline} />
    </div>
  </section>
</Base>
