---
import Base from "../layouts/Base.astro";
import DataStatusBanner from "../layouts/DataStatusBanner.astro";
import RadarCompare from "../islands/RadarCompare";
import PlayerCompare from "../islands/PlayerCompare";
import TimelineChart from "../islands/TimelineChart";
import { loadJson, loadCrestMap, type TeamSeasonSummary, type TimelineRow, type DerivedPlayerMetricRow, type SquadPlayerRow } from "../lib/data";
import { buildPlayerPositions } from "../lib/playerPositions";

const crests = loadCrestMap();

// Normaliza el shape {status, rows} de los agregados que aún no se scrapearon
// a un array vacío, para que el radar arranque en un modo con datos.
function loadArray<T>(filename: string): T[] {
  const raw = loadJson<T[] | { status: string; rows: [] }>(filename);
  return Array.isArray(raw) ? raw : [];
}

// Estadística de equipo real para LPF: team_season_summary / timeline_tactical
// (ambos de ESPN, por partido). No hay dato físico/GPS ni táctico por jugador
// para esta liga -- ver etl/fetch_espn_lpf.py.
const summary = loadArray<TeamSeasonSummary>("team_season_summary.json");
const timeline = loadJson<TimelineRow[]>("timeline_tactical.json");

// Comparación jugador a jugador (índice por factor + GLOBAL ponderado por posición).
const playerMetrics = loadArray<DerivedPlayerMetricRow>("derived_player_metrics.json");
const squadRows = loadArray<SquadPlayerRow>("squads.json");
const playerPositions = buildPlayerPositions(playerMetrics, squadRows);
---

<Base title="Comparar" description="Comparación cabeza a cabeza y evolución dentro de la temporada.">
  <DataStatusBanner />
  <p class="eyebrow">Cara a cara · dos clubes</p>
  <h1>Comparar</h1>
  <p class="lede">
    El modo <strong>uno contra uno</strong>: elegí <strong>dos</strong> y miralos lado a lado en un radar, con una
    lectura automática de las diferencias que más pesan. Podés comparar <strong>clubes</strong> o <strong>jugadores</strong>.
    <em>¿Querés ver a los 30 ordenados en una tabla? Eso está en Rankings. ¿Y quién ganaría?
    Probalo en <a href={`${import.meta.env.BASE_URL}prediccion/`}>Predicción</a>.</em>
  </p>

  <section class="section">
    <div class="section-head">
      <h2>Dos clubes</h2>
      <p>
        <strong>Fuerza</strong> de equipo (0–100, estilo EA SPORTS FC) en 4 categorías — ofensivo, control de pelota,
        defensivo e individual — el mismo cálculo que usa <a href={`${import.meta.env.BASE_URL}prediccion/`}>Predicción</a>
        para elegir favorito, para que nunca muestren números distintos para lo mismo.
      </p>
    </div>
    <div class="card">
      <RadarCompare client:only="react" summaryRows={summary} playerRows={playerMetrics} positions={playerPositions} crests={crests} />
    </div>
  </section>

  {playerMetrics.length > 0 && (
    <section class="section">
      <div class="section-head">
        <h2>Dos jugadores</h2>
        <p>
          Cara a cara en las <strong>5 categorías de rendimiento</strong> (4 para arqueros) — Ataque, Creación, Pase,
          Defensa y Valoración — con el <strong>GLOBAL ponderado por posición</strong> de cada uno, estilo EA SPORTS
          FC. <em>Tocá el radar para ver el desglose de cada categoría.</em>
        </p>
      </div>
      <div class="card">
        <PlayerCompare client:only="react" rows={playerMetrics} positions={playerPositions} />
      </div>
    </section>
  )}

  <section class="section">
    <div class="section-head">
      <h2>Evolución durante la temporada</h2>
      <p>Cómo cambia el juego de un club partido a partido. Se actualiza a medida que avanza la temporada.</p>
    </div>
    <div class="card">
      <TimelineChart client:only="react" rows={timeline} />
    </div>
  </section>
</Base>
