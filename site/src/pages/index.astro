---
import Base from "../layouts/Base.astro";

// Home = centro de análisis, no portada. El usuario entra con una pregunta
// ("¿qué querés analizar hoy?") y elige una acción, no una categoría. Todo el
// contenido explicativo, snapshots y tablas viven ya en sus páginas propias;
// acá no se duplican. La metodología queda a un click, discreta.
const base = import.meta.env.BASE_URL;

// Cada tarjeta enruta a la página existente que mejor responde la pregunta.
// "Comparar jugadores" -> jugadores/ (comparación física entre muchos a la vez);
// "Analizar un partido" -> analisis/ (goles vs. físico del mismo partido, radar).
const actions = [
  { href: `${base}comparar/`, icon: "🆚", label: "Comparar selecciones" },
  { href: `${base}jugadores/`, icon: "👟", label: "Comparar jugadores" },
  { href: `${base}analisis/`, icon: "🔎", label: "Analizar un partido" },
  { href: `${base}selecciones/`, icon: "📊", label: "Explorar rankings" },
];

// Compartir el sitio por WhatsApp (funcionalidad conservada, ahora liviana y
// genérica: sin depender de datos en vivo, no queda desactualizado).
const pageUrl = new URL(Astro.url.pathname, "https://ramirosilvera.github.io").href;
const shareMessage = `Métricas Mundial 2026: análisis físico y táctico de las 48 selecciones con datos reales y abiertos. Comparás selecciones, jugadores y partidos vos mismo 🇦🇷⚽ ${pageUrl}`;
const waLink = `https://wa.me/?text=${encodeURIComponent(shareMessage)}`;
---

<Base
  title="Inicio"
  description="Centro de análisis del Mundial 2026: compará selecciones, jugadores y partidos con datos reales y abiertos."
>
  <section class="home-hub">
    <p class="eyebrow">Métricas Mundial 2026</p>
    <h1 class="home-hub-title">¿Qué querés analizar hoy?</h1>

    <div class="cta-grid">
      {actions.map((a) => (
        <a class="cta-card" href={a.href}>
          <span class="cta-icon" aria-hidden="true">{a.icon}</span>
          <span class="cta-label">{a.label}</span>
          <span class="cta-arrow" aria-hidden="true">→</span>
        </a>
      ))}
    </div>

    <p class="home-hub-foot">
      <a href={`${base}metodologia/`}>¿Cómo calculamos esto?</a>
      <span class="home-hub-sep" aria-hidden="true">·</span>
      <a href={waLink} target="_blank" rel="noreferrer">📲 Compartir</a>
    </p>
  </section>
</Base>
