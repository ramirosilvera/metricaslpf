---
import Base from "../layouts/Base.astro";
import DataStatusBanner from "../layouts/DataStatusBanner.astro";
import { loadJson, type TeamSeasonSummary, type MatchRow } from "../lib/data";

const summary = loadJson<TeamSeasonSummary[]>("team_season_summary.json");
const matches = loadJson<MatchRow[]>("matches.json");
const physicalRaw = loadJson<any>("physical_match_stats.json");
const physicalRows: any[] = Array.isArray(physicalRaw) ? physicalRaw : [];

const arg2022 = summary.find((r) => r.team === "Argentina" && r.season === "2022");
const arg2018 = summary.find((r) => r.team === "Argentina" && r.season === "2018");
const nTeams = new Set(summary.map((r) => r.team)).size;
const base = import.meta.env.BASE_URL;

const matches2026Argentina = matches
  .filter((m) => m.season === "2026" && (m.home_team === "Argentina" || m.away_team === "Argentina"))
  .sort((a, b) => (a.match_date ?? "").localeCompare(b.match_date ?? ""));

function physicalFor(matchId: number, team: string) {
  return physicalRows.find((r) => r.match_id === matchId && r.team === team);
}
---

<Base title="Inicio" description="¿Argentina corre menos que el resto en el Mundial? Un análisis abierto, con los sesgos a la vista.">
  <DataStatusBanner />

  <h1>¿Argentina tiene una desventaja física real, o es un sesgo instalado?</h1>
  <p class="lede">
    Este proyecto pone a prueba esa hipótesis con datos abiertos y metodología explícita — no arranca mostrando un
    ranking. Antes de mirar cualquier gráfico, dos advertencias que condicionan todo lo que sigue.
  </p>

  <div class="grid-2 section">
    <div class="callout">
      <h3>1. La distancia corrida, sola, no mide "estado físico"</h3>
      <p>
        Los equipos que dominan el balón corren <em>menos</em>, no más — no persiguen. Sin normalizar por posesión,
        estado del marcador y fase del partido, un ranking de distancia es ruido táctico disfrazado de dato físico.
        Por eso este sitio separa siempre <strong>contexto táctico</strong> de <strong>resultado físico</strong>.
      </p>
    </div>
    <div class="callout warning">
      <h3>2. Con 4–7 partidos por torneo, no hay significancia estadística</h3>
      <p>
        Este proyecto es <strong>descriptivo</strong>, no un estudio causal. Todos los gráficos muestran dispersión
        (no solo promedios) y tamaño de muestra explícito. Ver <a href={`${base}metodologia/`}>metodología completa</a>.
      </p>
    </div>
  </div>

  <section class="section">
    <div class="section-head">
      <h2>Lo que ya sabemos con datos reales</h2>
      <p>Fuente: StatsBomb Open Data (contexto táctico), Mundiales 2018 y 2022</p>
    </div>
    <div class="stat-tiles">
      <div class="stat-tile">
        <div class="value">{nTeams}</div>
        <div class="label">selecciones con datos cargados</div>
      </div>
      <div class="stat-tile">
        <div class="value">{matches.length}</div>
        <div class="label">partidos procesados (2018 + 2022)</div>
      </div>
      <div class="stat-tile">
        <div class="value">{arg2022 ? Math.round(arg2022.posesion_promedio_proxy * 100) : "—"}%</div>
        <div class="label">posesión promedio (proxy) Argentina 2022, campeón</div>
      </div>
      <div class="stat-tile">
        <div class="value">{arg2018 ? Math.round(arg2018.posesion_promedio_proxy * 100) : "—"}%</div>
        <div class="label">posesión promedio (proxy) Argentina 2018, eliminada en octavos</div>
      </div>
    </div>
  </section>

  {matches2026Argentina.length > 0 && (
    <section class="section">
      <div class="section-head">
        <h2>Mundial 2026 — Argentina hasta el momento</h2>
        <p>Fuente: FIFA Training Centre (reporte oficial por partido)</p>
      </div>
      <div class="card">
        <table>
          <thead>
            <tr>
              <th>Fecha</th>
              <th>Fase</th>
              <th>Partido</th>
              <th>Estadio</th>
              <th>Distancia (equipo)</th>
              <th>Sprints (equipo)</th>
            </tr>
          </thead>
          <tbody>
            {matches2026Argentina.map((m) => {
              const argTeam = m.home_team === "Argentina" ? m.home_team : m.away_team;
              const phys = physicalFor(m.match_id, argTeam);
              return (
                <tr>
                  <td>{m.match_date ?? "—"}</td>
                  <td>{m.stage ?? "—"}</td>
                  <td>
                    {m.home_team} {m.home_score ?? "-"} – {m.away_score ?? "-"} {m.away_team}
                  </td>
                  <td>{m.stadium || "—"}</td>
                  <td>{phys ? `${phys.total_distance_km} km` : "pendiente"}</td>
                  <td>{phys ? phys.sprint_count : "pendiente"}</td>
                </tr>
              );
            })}
          </tbody>
        </table>
        <p style="font-size:0.8rem; color: var(--text-muted); margin-top: 0.75rem;">
          Detalle físico por jugador (distancia, zonas de velocidad, sprints, velocidad punta) en <a href={`${base}jugadores/`}>Jugadores</a>.
        </p>
      </div>
    </section>
  )}

  <section class="section">
    <div class="section-head">
      <h2>Cómo se completan los datos que faltan</h2>
    </div>
    <div class="card">
      <p>
        La métrica que responde directamente la hipótesis —distancia recorrida, alta intensidad, sprints— la publica <strong>FIFA Training Centre</strong> como
        reportes oficiales en PDF por partido, no como API. El scraper ya los descarga y decodifica automáticamente
        por GitHub Actions, corrida tras corrida va sumando más partidos del Mundial 2026 en curso. Igual con la edad
        de plantel (Transfermarkt), todavía pendiente. Este sitio nunca muestra un dato inventado: mientras un
        partido o una selección no tenga datos reales cargados, queda marcado como pendiente, explícitamente.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="section-head">
      <h2>Explorá</h2>
    </div>
    <div class="grid-2">
      <a class="card" href={`${base}selecciones/`} style="text-decoration:none; color:inherit;">
        <h3>Selecciones →</h3>
        <p>Rankings, boxplots de dispersión y heatmap de percentiles entre selecciones.</p>
      </a>
      <a class="card" href={`${base}comparar/`} style="text-decoration:none; color:inherit;">
        <h3>Comparar dos selecciones →</h3>
        <p>Radar cabeza a cabeza normalizado por percentil.</p>
      </a>
      <a class="card" href={`${base}jugadores/`} style="text-decoration:none; color:inherit;">
        <h3>Jugadores →</h3>
        <p>Minutos jugados por plantel — la unidad de análisis correcta, no el promedio de equipo.</p>
      </a>
      <a class="card" href={`${base}explorador/`} style="text-decoration:none; color:inherit;">
        <h3>Explorador SQL →</h3>
        <p>Consultas libres sobre los datos crudos (Parquet), corriendo en tu navegador con DuckDB-WASM.</p>
      </a>
    </div>
  </section>
</Base>
