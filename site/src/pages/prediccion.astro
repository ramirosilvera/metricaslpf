---
import Base from "../layouts/Base.astro";
import DataStatusBanner from "../layouts/DataStatusBanner.astro";
import MatchPredictor from "../islands/MatchPredictor";
import { loadJson, type TeamSeasonSummary, type DerivedPlayerMetricRow, type SquadPlayerRow } from "../lib/data";
import { buildPlayerPositions } from "../lib/playerPositions";

function loadArray<T>(filename: string): T[] {
  const raw = loadJson<T[] | { status: string; rows: [] }>(filename);
  return Array.isArray(raw) ? raw : [];
}

const teamRows = loadArray<TeamSeasonSummary>("team_season_summary.json");
const playerMetrics = loadArray<DerivedPlayerMetricRow>("derived_player_metrics.json");
const squadRows = loadArray<SquadPlayerRow>("squads.json");
const positions = buildPlayerPositions(playerMetrics, squadRows);

const base = import.meta.env.BASE_URL;
const ready = teamRows.length > 0;
---

<Base
  title="Predicción de partido"
  description="Predicción de un partido de la Liga Profesional Argentina a partir del rendimiento de equipo e individual: probabilidades, goles esperados y escenarios."
>
  <DataStatusBanner />
  <p class="eyebrow">¿Qué puede pasar?</p>
  <h1>Predicción de partido</h1>
  <p class="lede">
    Elegí dos clubes y el modelo estima <strong>quién llega mejor</strong> según su rendimiento en la Liga
    Profesional: ofensivo, control de la pelota y defensivo <strong>de equipo</strong> más la calidad
    <strong>individual</strong> ponderada por posición. Sale una probabilidad 1-X-2, un marcador esperado y
    <strong>escenarios de cómo se puede desarrollar</strong>. Es un modelo transparente para dimensionar el cruce, no
    una bola de cristal.
  </p>

  {ready ? (
    <section class="section">
      <div class="card">
        <MatchPredictor
          client:only="react"
          teamRows={teamRows}
          playerRows={playerMetrics}
          positions={positions}
        />
      </div>
    </section>
  ) : (
    <section class="section">
      <p style="color: var(--text-muted);">
        Todavía no hay suficientes datos de equipo cargados para predecir. Se completan a medida que el pipeline
        procesa los partidos — mirá el estado arriba. Mientras tanto podés mirar el <a href={`${base}comparar/`}>radar
        cabeza a cabeza</a>.
      </p>
    </section>
  )}
</Base>
