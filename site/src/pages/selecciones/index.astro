---
import Base from "../../layouts/Base.astro";
import DataStatusBanner from "../../layouts/DataStatusBanner.astro";
import TeamPhysicalRanking from "../../islands/TeamPhysicalRanking";
import TeamTacticalRanking from "../../islands/TeamTacticalRanking";
import TeamPhysicalTrend from "../../islands/TeamPhysicalTrend";
import {
  loadJson,
  type TeamPhysicalRankingRow,
  type TeamTacticalRankingRow,
  type TeamPhysicalTrendRow,
} from "../../lib/data";
import { flagFor } from "../../lib/flags";
import ShareCardButton from "../../islands/ShareCardButton";

function loadArray<T>(filename: string): T[] {
  const raw = loadJson<T[] | { status: string; rows: [] }>(filename);
  return Array.isArray(raw) ? raw : [];
}

const teamPhysical = loadArray<TeamPhysicalRankingRow>("team_physical_ranking.json");
const teamTactical = loadArray<TeamTacticalRankingRow>("team_tactical_ranking.json");
const teamTrend = loadArray<TeamPhysicalTrendRow>("team_physical_trend.json");

const nPhysicalTeams = teamPhysical.length;

const distanceLeader = [...teamPhysical].sort((a, b) => b.distancia_promedio_km - a.distancia_promedio_km)[0] ?? null;
const leaderStats = distanceLeader
  ? [
      { label: "Distancia / partido", value: `${distanceLeader.distancia_promedio_km} km` },
      { label: "Sprints / partido", value: String(Math.round(distanceLeader.sprints_promedio)) },
      { label: "Velocidad punta", value: `${distanceLeader.velocidad_punta_kmh} km/h` },
    ]
  : [];
const leaderShareText = distanceLeader
  ? `${distanceLeader.team} lidera la distancia recorrida por partido entre las 48 selecciones del Mundial 2026: ${distanceLeader.distancia_promedio_km} km. Ojo: correr más no es necesariamente "mejor" — mirá el contexto táctico antes de sacar conclusiones.`
  : undefined;
---

<Base title="Selecciones" description="Rendimiento físico real de las 48 selecciones del Mundial 2026, ranking FIFA y contexto táctico.">
  <DataStatusBanner />
  <p class="eyebrow">Ranking · las 48 selecciones</p>
  <h1>Ranking de selecciones</h1>
  <p class="lede">
    La <strong>tabla del torneo</strong>: las {nPhysicalTeams || 48} selecciones ordenadas de mayor a menor en la
    métrica que elijas, física (FIFA Training Centre) o táctica. Clave metodológica: un equipo que domina el balón corre
    <em>menos</em>, no más — por eso lo físico se lee junto a lo táctico, nunca solo. <em>Para enfrentar dos entre sí,
    usá Comparar.</em>
  </p>

  {distanceLeader && (
    <div class="hero-actions" style="margin-bottom: 1.5rem;">
      <ShareCardButton
        client:only="react"
        title={distanceLeader.team}
        subtitle={`${flagFor(distanceLeader.team)} Líder en distancia recorrida · Mundial 2026`}
        flag={flagFor(distanceLeader.team)}
        stats={leaderStats}
        tagline={`Entre ${nPhysicalTeams || 48} selecciones analizadas`}
        shareText={leaderShareText}
        filenameBase={`${distanceLeader.team}-lider-distancia`}
      />
    </div>
  )}

  {teamPhysical.length > 0 && (
    <section class="section">
      <div class="section-head">
        <h2>Ranking físico del torneo — 48 selecciones</h2>
        <p>Distancia, alta intensidad, sprints y velocidad punta de cada equipo. Datos reales del Mundial 2026 en curso.</p>
      </div>
      <div class="card">
        <TeamPhysicalRanking client:only="react" rows={teamPhysical} />
      </div>
    </section>
  )}

  {teamTactical.length > 0 && (
    <section class="section">
      <div class="section-head">
        <h2>Ranking táctico del torneo — 48 selecciones</h2>
        <p>Progresiones, presión, recuperaciones, precisión de pase y más — el juego con la pelota de cada equipo, del Mundial 2026 en curso (FIFA Training Centre).</p>
      </div>
      <div class="card">
        <TeamTacticalRanking client:only="react" rows={teamTactical} />
      </div>
    </section>
  )}

  {teamTrend.length > 0 && (
    <section class="section">
      <div class="section-head">
        <h2>Forma física dentro del torneo</h2>
        <p>¿La selección corre más o menos a medida que avanza el Mundial? Un punto por partido, contra la media del torneo.</p>
      </div>
      <div class="card">
        <TeamPhysicalTrend client:only="react" rows={teamTrend} />
      </div>
    </section>
  )}

</Base>
