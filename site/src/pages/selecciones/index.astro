---
import Base from "../../layouts/Base.astro";
import DataStatusBanner from "../../layouts/DataStatusBanner.astro";
import RankingBar from "../../islands/RankingBar";
import PossessionBoxplot from "../../islands/PossessionBoxplot";
import MetricHeatmap from "../../islands/MetricHeatmap";
import TeamPhysicalRanking from "../../islands/TeamPhysicalRanking";
import TeamPhysicalTrend from "../../islands/TeamPhysicalTrend";
import {
  loadJson,
  type TeamSeasonSummary,
  type BoxplotRow,
  type TeamProfileRow,
  type TeamPhysicalRankingRow,
  type TeamPhysicalTrendRow,
} from "../../lib/data";
import { flagFor } from "../../lib/flags";

function loadArray<T>(filename: string): T[] {
  const raw = loadJson<T[] | { status: string; rows: [] }>(filename);
  return Array.isArray(raw) ? raw : [];
}

const summary = loadJson<TeamSeasonSummary[]>("team_season_summary.json");
const boxplot = loadJson<BoxplotRow[]>("boxplot_possession_proxy.json");
const teamPhysical = loadArray<TeamPhysicalRankingRow>("team_physical_ranking.json");
const teamTrend = loadArray<TeamPhysicalTrendRow>("team_physical_trend.json");

const profilesRaw = loadJson<TeamProfileRow[] | { status: string; rows: [] }>("team_profile.json");
const profiles = (Array.isArray(profilesRaw) ? profilesRaw : []).sort(
  (a, b) => (a.fifa_ranking ?? 999) - (b.fifa_ranking ?? 999),
);

const nPhysicalTeams = teamPhysical.length;

// país anfitrión del campamento base (la sede es siempre US/MX/CA)
const HOST_FLAGS: Record<string, string> = { US: "🇺🇸", MX: "🇲🇽", CA: "🇨🇦" };
---

<Base title="Selecciones" description="Rendimiento físico real de las 48 selecciones del Mundial 2026, ranking FIFA y contexto táctico.">
  <DataStatusBanner />
  <p class="eyebrow">Análisis colectivo</p>
  <h1>Selecciones</h1>
  <p class="lede">
    Rendimiento físico real del Mundial 2026 para las {nPhysicalTeams || 48} selecciones (FIFA Training Centre), más el
    contexto táctico que hace falta para leerlo bien. Recordá la clave metodológica: un equipo que domina el balón corre
    <em>menos</em>, no más — por eso lo físico se lee junto a lo táctico, nunca solo.
  </p>

  {teamPhysical.length > 0 && (
    <section class="section">
      <div class="section-head">
        <h2>Ranking físico del torneo — 48 selecciones</h2>
        <p>Distancia, alta intensidad, sprints y velocidad punta de cada equipo. Datos reales del Mundial 2026 en curso.</p>
      </div>
      <div class="card">
        <TeamPhysicalRanking client:only="react" rows={teamPhysical} />
      </div>
    </section>
  )}

  {teamTrend.length > 0 && (
    <section class="section">
      <div class="section-head">
        <h2>Forma física dentro del torneo</h2>
        <p>¿La selección corre más o menos a medida que avanza el Mundial? Un punto por partido, contra la media del torneo.</p>
      </div>
      <div class="card">
        <TeamPhysicalTrend client:only="react" rows={teamTrend} />
      </div>
    </section>
  )}

  <section class="section">
    <div class="section-head">
      <h2>Contexto táctico (StatsBomb, 2018 + 2022)</h2>
      <p>
        Estilo de juego —posesión, precisión de pase, volumen de remate— como variable de <em>control</em>. Semilla
        histórica de StatsBomb, no métricas físicas: sirve para no confundir "corre poco" con "juega mal".
      </p>
    </div>
    <div class="card">
      <RankingBar client:only="react" rows={summary} />
    </div>
  </section>

  <section class="section">
    <div class="section-head">
      <h2>Distribución de posesión por selección</h2>
      <p>Cada punto es un partido — la dispersión importa más que el promedio con n tan chico.</p>
    </div>
    <div class="card">
      <PossessionBoxplot client:only="react" rows={boxplot} />
    </div>
  </section>

  <section class="section">
    <div class="section-head"><h2>Heatmap de percentiles tácticos</h2></div>
    <div class="card">
      <MetricHeatmap client:only="react" rows={summary} />
    </div>
  </section>

  {profiles.length > 0 && (
    <section class="section">
      <div class="section-head">
        <h2>Ranking FIFA y campamento base</h2>
        <p>Fuente: API pública de FIFA — la flecha compara contra el ranking previo al torneo.</p>
      </div>
      <div class="card">
        <div class="table-scroll">
          <table>
            <thead>
              <tr>
                <th>Ranking FIFA</th>
                <th>Selección</th>
                <th>Grupo</th>
                <th>Campamento base</th>
                <th>Sede de entrenamiento</th>
              </tr>
            </thead>
            <tbody>
              {profiles.map((p) => {
                const delta =
                  p.fifa_ranking != null && p.fifa_ranking_prev != null ? p.fifa_ranking_prev - p.fifa_ranking : null;
                return (
                  <tr>
                    <td>
                      <span class="match-score">{p.fifa_ranking ?? "—"}</span>{" "}
                      {delta != null && delta > 0 && <span class="rank-delta up">▲{delta}</span>}
                      {delta != null && delta < 0 && <span class="rank-delta down">▼{-delta}</span>}
                      {delta === 0 && <span class="rank-delta same">=</span>}
                    </td>
                    <td>
                      <span class="team-flag">{flagFor(p.team)}</span>{p.team}{" "}
                      <span class="fifa-code">{p.fifa_code}</span>
                    </td>
                    <td>{p.group}</td>
                    <td>
                      {p.base_camp_city ?? "—"}{" "}
                      {p.base_camp_country ? HOST_FLAGS[p.base_camp_country] ?? p.base_camp_country : ""}
                    </td>
                    <td>{p.base_camp_facility ?? "—"}</td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      </div>
    </section>
  )}
</Base>

<style>
  .rank-delta {
    font-size: 0.74rem;
    font-weight: 700;
    font-family: var(--font-mono);
    white-space: nowrap;
  }

  .rank-delta.up {
    color: var(--win);
  }

  .rank-delta.down {
    color: var(--loss);
  }

  .rank-delta.same {
    color: var(--text-muted);
  }

  .fifa-code {
    font-size: 0.72rem;
    font-family: var(--font-mono);
    color: var(--text-muted);
    letter-spacing: 0.04em;
  }
</style>
