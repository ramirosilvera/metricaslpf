---
import Base from "../layouts/Base.astro";
import DataStatusBanner from "../layouts/DataStatusBanner.astro";
import PlayerMinutesBar from "../islands/PlayerMinutesBar";
import PhysicalPlayerBar from "../islands/PhysicalPlayerBar";
import { loadJson, type PlayerMinutesRow } from "../lib/data";
import type { PhysicalPlayerRankingRow } from "../islands/PhysicalPlayerBar";

const players = loadJson<PlayerMinutesRow[]>("player_minutes_ranking.json");
const physicalRaw = loadJson<PhysicalPlayerRankingRow[] | { status: string; rows: [] }>("physical_player_ranking.json");
const physicalPlayers: PhysicalPlayerRankingRow[] = Array.isArray(physicalRaw) ? physicalRaw : [];
---

<Base title="Jugadores" description="Ranking de minutos jugados y métricas físicas reales por jugador — Mundial 2026.">
  <DataStatusBanner />
  <h1>Jugadores</h1>
  <p class="lede">
    Un promedio de equipo esconde que algunos jugadores corren mucho y otros poco — esta es la unidad de análisis
    correcta para poner a prueba la hipótesis.
  </p>

  <section class="section">
    <div class="section-head">
      <h2>Métricas físicas reales — Mundial 2026</h2>
      <p>Fuente: FIFA Training Centre (reportes oficiales por partido, PMSR)</p>
    </div>
    <div class="card">
      <PhysicalPlayerBar client:only="react" rows={physicalPlayers} />
    </div>
  </section>

  <section class="section">
    <div class="section-head">
      <h2>Minutos jugados (histórico StatsBomb, 2018 + 2022)</h2>
    </div>
    <div class="card">
      <PlayerMinutesBar client:only="react" rows={players} />
    </div>
  </section>
</Base>
