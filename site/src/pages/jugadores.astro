---
import Base from "../layouts/Base.astro";
import DataStatusBanner from "../layouts/DataStatusBanner.astro";
import PlayerGlobalIndexRanking from "../islands/PlayerGlobalIndexRanking";
import PlayerFactorRanking from "../islands/PlayerFactorRanking";
import { loadJson, type DerivedPlayerMetricRow, type SquadPlayerRow } from "../lib/data";
import { buildPlayerPositions } from "../lib/playerPositions";

function loadArray<T>(filename: string): T[] {
  const raw = loadJson<T[] | { status: string; rows: [] }>(filename);
  return Array.isArray(raw) ? raw : [];
}

const playerMetrics = loadArray<DerivedPlayerMetricRow>("derived_player_metrics.json");
const squadRows = loadArray<SquadPlayerRow>("squads.json");

// Posición por jugador para ponderar el índice global por posición (estilo EA FC).
const positions = buildPlayerPositions(playerMetrics, squadRows);
---

<Base title="Jugadores" description="Ranking de jugadores de la Liga Profesional Argentina: índice global y comparación por cada categoría de estadística de FotMob.">
  <DataStatusBanner />
  <p class="eyebrow">Ranking · jugador por jugador</p>
  <h1>Ranking de jugadores</h1>
  <p class="lede">
    Dos maneras de ordenar a los jugadores de la Liga Profesional: por un <strong>índice global</strong> que resume todo su
    rendimiento de la temporada, o <strong>factor por factor</strong> para ver quién manda en cada una de las 37
    categorías de FotMob. En ambas podés mirar el <strong>top de la liga</strong> o filtrar <strong>por club</strong>.
    <em>Para la ficha completa de un jugador, entrá a Analizar.</em>
  </p>

  {playerMetrics.length > 0 ? (
    <>
      <section class="section">
        <div class="section-head">
          <h2>Índice global — el mejor de cada club</h2>
          <p>
            El <strong>GLOBAL</strong> estilo EA SPORTS FC: un solo número (0–100) por jugador que combina su índice de
            rendimiento en cada categoría <strong>ponderado por su posición</strong> — al delantero le pesan los goles y
            el xG; al defensor, los tackles y despejes; al arquero, las atajadas y goles evitados. Elegí un club o el
            top de la liga. <em>Tocá un jugador para ver el desglose factor por factor.</em>
          </p>
        </div>
        <div class="card">
          <PlayerGlobalIndexRanking client:only="react" rows={playerMetrics} positions={positions} />
        </div>
      </section>

      <section class="section">
        <div class="section-head">
          <h2>Comparación por factor — ¿quién manda en cada métrica?</h2>
          <p>
            Elegí <strong>cualquiera de las 37 categorías</strong> de FotMob (goles, xG, xA, remates, pases, tackles,
            intercepciones, atajadas, tarjetas y más) y ordená a los jugadores por ese factor — <strong>entre todos los
            clubes</strong> o <strong>dentro de uno solo</strong>. <em>Tocá un jugador para ver su valor oficial y el
            índice.</em>
          </p>
        </div>
        <div class="card">
          <PlayerFactorRanking client:only="react" rows={playerMetrics} positions={positions} />
        </div>
      </section>
    </>
  ) : (
    <section class="section">
      <p style="color: var(--text-muted);">
        Todavía no hay métricas por jugador cargadas. Se completan corriendo etl/fetch_fotmob_lpf.py — mirá el estado
        arriba.
      </p>
    </section>
  )}
</Base>
