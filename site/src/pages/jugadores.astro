---
import Base from "../layouts/Base.astro";
import DataStatusBanner from "../layouts/DataStatusBanner.astro";
import PlayerGlobalIndexRanking from "../islands/PlayerGlobalIndexRanking";
import PlayerFactorRanking from "../islands/PlayerFactorRanking";
import { loadJson, type DerivedPlayerMetricRow, type SquadPlayerRow } from "../lib/data";
import { buildPlayerPositions } from "../lib/playerPositions";

function loadArray<T>(filename: string): T[] {
  const raw = loadJson<T[] | { status: string; rows: [] }>(filename);
  return Array.isArray(raw) ? raw : [];
}

const playerMetrics = loadArray<DerivedPlayerMetricRow>("derived_player_metrics.json");
const squadRows = loadArray<SquadPlayerRow>("squads.json");

// Posición por jugador para ponderar el índice global por posición (estilo EA FC).
const positions = buildPlayerPositions(playerMetrics, squadRows);
---

<Base title="Jugadores" description="Ranking de jugadores del Mundial 2026: índice global y comparación por cada factor físico y táctico.">
  <DataStatusBanner />
  <p class="eyebrow">Ranking · jugador por jugador</p>
  <h1>Ranking de jugadores</h1>
  <p class="lede">
    Dos maneras de ordenar a los jugadores del Mundial 2026: por un <strong>índice global</strong> que resume todo su
    rendimiento, o <strong>factor por factor</strong> para ver quién manda en cada métrica física y táctica. En ambas
    podés mirar el <strong>top del torneo</strong> o filtrar <strong>por selección</strong>. <em>Para la ficha completa de
    un jugador, entrá a Analizar.</em>
  </p>

  {playerMetrics.length > 0 ? (
    <>
      <section class="section">
        <div class="section-head">
          <h2>Índice global — el mejor de cada selección</h2>
          <p>
            El <strong>GLOBAL</strong> estilo EA SPORTS FC: un solo número (0–100) por jugador que combina su índice de
            rendimiento en cada factor físico y táctico <strong>ponderado por su posición</strong> — al delantero le pesan
            los remates, la velocidad y la progresión; al defensor, los quites y recuperaciones. Elegí una selección o el
            top del torneo. <em>Tocá un jugador para ver el desglose factor por factor.</em>
          </p>
        </div>
        <div class="card">
          <PlayerGlobalIndexRanking client:only="react" rows={playerMetrics} positions={positions} />
        </div>
      </section>

      <section class="section">
        <div class="section-head">
          <h2>Comparación por factor — ¿quién manda en cada métrica?</h2>
          <p>
            Elegí <strong>cualquiera de los 12 factores</strong> físicos (distancia, alta intensidad, sprints, velocidad
            punta) o tácticos (pases, precisión, progresiones, remates, tackles, intercepciones, presión, recuperaciones)
            y ordená a los jugadores por ese factor — <strong>entre todas las selecciones</strong> o <strong>dentro de una
            sola</strong>. <em>Tocá un jugador para ver su valor oficial y el índice.</em>
          </p>
        </div>
        <div class="card">
          <PlayerFactorRanking client:only="react" rows={playerMetrics} positions={positions} />
        </div>
      </section>
    </>
  ) : (
    <section class="section">
      <p style="color: var(--text-muted);">
        Todavía no hay métricas por jugador cargadas. Se completan a medida que el scraper procesa los partidos del
        Mundial 2026 — mirá el estado arriba.
      </p>
    </section>
  )}
</Base>
