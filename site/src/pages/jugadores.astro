---
import Base from "../layouts/Base.astro";
import DataStatusBanner from "../layouts/DataStatusBanner.astro";
import ConfidenceBadge from "../layouts/ConfidenceBadge.astro";
import PlayerMinutesBar from "../islands/PlayerMinutesBar";
import PhysicalPlayerBar from "../islands/PhysicalPlayerBar";
import PositionPhysicalRanking from "../islands/PositionPhysicalRanking";
import PlayerGlobalIndexRanking from "../islands/PlayerGlobalIndexRanking";
import { loadJson, type PlayerMinutesRow, type PlayerPhysicalPositionRow, type DerivedPlayerMetricRow } from "../lib/data";
import type { PhysicalPlayerRankingRow } from "../islands/PhysicalPlayerBar";

function loadArray<T>(filename: string): T[] {
  const raw = loadJson<T[] | { status: string; rows: [] }>(filename);
  return Array.isArray(raw) ? raw : [];
}

const players = loadJson<PlayerMinutesRow[]>("player_minutes_ranking.json");
const physicalPlayers = loadArray<PhysicalPlayerRankingRow>("physical_player_ranking.json");
const byPosition = loadArray<PlayerPhysicalPositionRow>("player_physical_by_position.json");
const playerMetrics = loadArray<DerivedPlayerMetricRow>("derived_player_metrics.json");
---

<Base title="Jugadores" description="Ranking de minutos jugados y métricas físicas reales por jugador — Mundial 2026.">
  <DataStatusBanner />
  <p class="eyebrow">Ranking · jugador por jugador</p>
  <h1>Ranking de jugadores</h1>
  <p class="lede">
    La misma <strong>tabla</strong>, pero a nivel jugador: quién corre más, comparado por posición y por minutos. Un
    promedio de equipo esconde que algunos corren mucho y otros poco — esta es la unidad correcta para poner a prueba la
    hipótesis. <em>Para la ficha completa de un jugador, entrá a Analizar.</em>
  </p>

  {playerMetrics.length > 0 && (
    <section class="section">
      <div class="section-head">
        <h2>Índice global — el mejor de cada selección</h2>
        <p>
          El <strong>GLOBAL</strong> estilo EA SPORTS FC: un solo número (0–100) por jugador, promedio de su índice de
          rendimiento en cada factor físico y táctico. Elegí una selección para ver a sus jugadores ordenados de mayor a
          menor, o mirá el top del torneo. <em>Tocá un jugador para ver el desglose factor por factor.</em>
        </p>
      </div>
      <div class="card">
        <PlayerGlobalIndexRanking client:only="react" rows={playerMetrics} />
      </div>
    </section>
  )}

  {byPosition.length > 0 && (
    <section class="section">
      <div class="section-head">
        <h2>Comparación física normalizada por posición</h2>
        <p>
          Un central y un extremo no se miden con la misma vara. Acá cada jugador se muestra como % del mejor de su
          posición (arqueros, defensores, mediocampistas, delanteros), así la comparación es justa — y podés comparar
          decenas de jugadores a la vez, no de a dos.
        </p>
      </div>
      <div class="card">
        <PositionPhysicalRanking client:only="react" rows={byPosition} />
      </div>
    </section>
  )}

  <section class="section">
    <div class="section-head">
      <h2>Métricas físicas por selección — Mundial 2026</h2>
      <ConfidenceBadge source="physical_performance" label="Fuente: FIFA Training Centre (PMSR)" />
    </div>
    <div class="card">
      <PhysicalPlayerBar client:only="react" rows={physicalPlayers} />
    </div>
  </section>

  <section class="section">
    <div class="section-head">
      <h2>Minutos jugados (histórico StatsBomb, 2018 + 2022)</h2>
    </div>
    <div class="card">
      <PlayerMinutesBar client:only="react" rows={players} />
    </div>
  </section>
</Base>
