---
import Base from "../layouts/Base.astro";
import DataStatusBanner from "../layouts/DataStatusBanner.astro";
import ConfidenceBadge from "../layouts/ConfidenceBadge.astro";
import { loadJson, loadCrestMap, type GoalEventRow } from "../lib/data";
import GoalScorerRanking from "../islands/GoalScorerRanking";

function loadArray<T>(filename: string): T[] {
  const raw = loadJson<T[] | { status: string; rows: [] }>(filename);
  return Array.isArray(raw) ? raw : [];
}

const crests = loadCrestMap();
const goalEvents = loadArray<GoalEventRow>("goal_events.json");
---

<Base title="Goleadores" description="Tabla de goleadores de la Liga Profesional Argentina: goles, penales y partidos con gol por jugador, con datos reales de ESPN.">
  <DataStatusBanner />
  <p class="eyebrow">Liga Profesional · temporada en curso</p>
  <h1>Goleadores</h1>
  <p class="lede">
    Todos los goles de la temporada, gol por gol, con datos reales de ESPN. Los penales convertidos están incluidos
    en el total de goles; los goles en contra no suman a ningún goleador y se listan aparte.
  </p>

  <section class="section">
    <div class="section-head">
      <h2>Tabla de goleadores</h2>
      <ConfidenceBadge source="goal_events" label="Fuente: ESPN" />
    </div>
    <GoalScorerRanking client:only="react" goalEvents={goalEvents} crests={crests} />
  </section>
</Base>
