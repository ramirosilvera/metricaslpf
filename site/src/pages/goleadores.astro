---
import Base from "../layouts/Base.astro";
import DataStatusBanner from "../layouts/DataStatusBanner.astro";
import { loadJson, type GoalEventRow, type GoalScorerRankingRow, type OwnGoalRow } from "../lib/data";
import { flagFor } from "../lib/flags";
import ShareCardButton from "../islands/ShareCardButton";

function loadArray<T>(filename: string): T[] {
  const raw = loadJson<T[] | { status: string; rows: [] }>(filename);
  return Array.isArray(raw) ? raw : [];
}

const scorers = loadArray<GoalScorerRankingRow>("goal_scorer_ranking.json");
const ownGoals = loadArray<OwnGoalRow>("own_goals.json");
const goalEvents = loadArray<GoalEventRow>("goal_events.json");

// El JSON ya viene ordenado, pero se reordena de forma defensiva para que la
// tabla nunca dependa del orden de serialización del scraper.
const sorted = [...scorers].sort(
  (a, b) => b.goles - a.goles || b.partidos_con_gol - a.partidos_con_gol || a.player_name.localeCompare(b.player_name),
);

// Posición estilo tabla de goleadores: los empatados comparten número (1, 2, 2, 4...).
const posByGoals = new Map<number, number>();
sorted.forEach((r, i) => {
  if (!posByGoals.has(r.goles)) posByGoals.set(r.goles, i + 1);
});

const multi = sorted.filter((r) => r.goles >= 2);
const single = sorted.filter((r) => r.goles < 2);

const totalGoals = goalEvents.length;
const penaltyGoals = goalEvents.filter((g) => g.penalty).length;
const ownGoalCount = goalEvents.filter((g) => g.own_goal).length;
const updatedAt = goalEvents[0]?.retrieved_at?.slice(0, 10) ?? null;

const topScorer = sorted[0] ?? null;
const topScorerStats = topScorer
  ? [
      { label: "Goles", value: String(topScorer.goles) },
      { label: "Penales", value: String(topScorer.penales) },
      { label: "Partidos con gol", value: String(topScorer.partidos_con_gol) },
    ]
  : [];
const topScorerShareText = topScorer
  ? `${topScorer.player_name} (${topScorer.team}) lidera la tabla de goleadores del Mundial 2026 con ${topScorer.goles} goles en ${topScorer.partidos_con_gol} partidos.`
  : undefined;
---

<Base title="Goleadores" description="Tabla de goleadores del Mundial 2026: goles, penales y partidos con gol por jugador, con datos abiertos de openfootball.">
  <DataStatusBanner />
  <p class="eyebrow">Mundial 2026 · en curso</p>
  <h1>Goleadores</h1>
  <p class="lede">
    Todos los goles del torneo, gol por gol, desde datos abiertos (openfootball). Los penales convertidos están
    incluidos en el total de goles; los goles en contra no suman a ningún goleador y se listan aparte.
  </p>

  {topScorer && (
    <div class="hero-actions" style="margin-bottom: 1.5rem;">
      <ShareCardButton
        client:only="react"
        title={topScorer.player_name}
        subtitle={`${flagFor(topScorer.team)} ${topScorer.team} · Goleador del Mundial 2026`}
        flag={flagFor(topScorer.team)}
        stats={topScorerStats}
        tagline="Máximo goleador del torneo"
        shareText={topScorerShareText}
        filenameBase={`${topScorer.player_name}-goleador`}
      />
    </div>
  )}

  <section class="section">
    <div class="stat-tiles">
      <div class="stat-tile">
        <div class="value">{totalGoals}</div>
        <div class="label">goles en el torneo</div>
      </div>
      <div class="stat-tile">
        <div class="value">{scorers.length}</div>
        <div class="label">goleadores distintos</div>
      </div>
      <div class="stat-tile">
        <div class="value">{penaltyGoals}</div>
        <div class="label">goles de penal</div>
      </div>
      <div class="stat-tile">
        <div class="value">{ownGoalCount}</div>
        <div class="label">goles en contra</div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section-head">
      <h2>Tabla de goleadores</h2>
      <p>Fuente: openfootball (datos abiertos){updatedAt ? ` · actualizado ${updatedAt}` : ""}</p>
    </div>
    <div class="card">
      <div class="table-scroll">
        <table>
          <caption>Jugadores con dos o más goles ({multi.length} de {scorers.length})</caption>
          <thead>
            <tr>
              <th>#</th>
              <th>Jugador</th>
              <th>Selección</th>
              <th>Goles</th>
              <th>Penales</th>
              <th>Partidos con gol</th>
            </tr>
          </thead>
          <tbody>
            {multi.map((r) => (
              <tr>
                <td class="match-score">{posByGoals.get(r.goles)}</td>
                <td>{r.player_name}</td>
                <td><span class="team-flag">{flagFor(r.team)}</span>{r.team}</td>
                <td class="match-score">{r.goles}</td>
                <td>{r.penales > 0 ? r.penales : "—"}</td>
                <td>{r.partidos_con_gol}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      {single.length > 0 && (
        <details class="scorers-more">
          <summary>Ver los {single.length} jugadores con un gol</summary>
          <div class="table-scroll">
            <table>
              <thead>
                <tr>
                  <th>#</th>
                  <th>Jugador</th>
                  <th>Selección</th>
                  <th>Goles</th>
                  <th>Penales</th>
                  <th>Partidos con gol</th>
                </tr>
              </thead>
              <tbody>
                {single.map((r) => (
                  <tr>
                    <td class="match-score">{posByGoals.get(r.goles)}</td>
                    <td>{r.player_name}</td>
                    <td><span class="team-flag">{flagFor(r.team)}</span>{r.team}</td>
                    <td class="match-score">{r.goles}</td>
                    <td>{r.penales > 0 ? r.penales : "—"}</td>
                    <td>{r.partidos_con_gol}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </details>
      )}
    </div>
  </section>

  {ownGoals.length > 0 && (
    <section class="section">
      <div class="callout warning">
        <h3>Goles en contra ({ownGoals.length})</h3>
        <p>
          No suman en la tabla de goleadores — se acreditan a la selección beneficiada, no al jugador.
        </p>
        <ul class="own-goal-list">
          {ownGoals.map((o) => (
            <li>
              {o.player_name}
              {o.goles_en_contra > 1 ? ` (×${o.goles_en_contra})` : ""} — benefició a{" "}
              <span class="team-flag">{flagFor(o.equipo_beneficiado)}</span>{o.equipo_beneficiado}
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}
</Base>

<style>
  .scorers-more {
    margin-top: 1rem;
  }

  .scorers-more summary {
    cursor: pointer;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--brand-strong);
    padding: 0.5rem 0;
  }

  .scorers-more[open] summary {
    margin-bottom: 0.5rem;
  }

  .own-goal-list {
    margin: 0.6rem 0 0;
    padding-left: 1.2rem;
    color: var(--text-secondary);
    font-size: 0.9rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
</style>
