---
import Base from "../layouts/Base.astro";
import DataStatusBanner from "../layouts/DataStatusBanner.astro";
import ClubConsistencyScatter from "../islands/ClubConsistencyScatter";
import { loadJson, loadCrestMap, type DerivedPlayerMetricRow, type SquadPlayerRow, type MatchRow } from "../lib/data";
import { buildPlayerPositions } from "../lib/playerPositions";
import { computeReferenceTable, computeClubConsistency } from "../lib/clubConsistency";

const crests = loadCrestMap();

function loadArray<T>(filename: string): T[] {
  const raw = loadJson<T[] | { status: string; rows: [] }>(filename);
  return Array.isArray(raw) ? raw : [];
}

const matches = loadArray<MatchRow>("matches.json");
const playerMetrics = loadArray<DerivedPlayerMetricRow>("derived_player_metrics.json");
const squadRows = loadArray<SquadPlayerRow>("squads.json");

const positions = buildPlayerPositions(playerMetrics, squadRows);
const referenceTable = computeReferenceTable(matches);
const consistency = referenceTable ? computeClubConsistency(playerMetrics, positions, referenceTable.rows) : [];

const STAGE_LABELS: Record<string, string> = {
  "torneo-apertura": "Torneo Apertura",
  "torneo-clausura": "Torneo Clausura",
};
const stageLabel = referenceTable ? (STAGE_LABELS[referenceTable.stage] ?? referenceTable.stage) : null;
---

<Base
  title="Consistencia club-jugador"
  description="¿El rendimiento individual agregado de cada club de la Liga Profesional Argentina es consistente con lo que rinde en la tabla?"
>
  <DataStatusBanner />
  <p class="eyebrow">Análisis · cruce club-jugador</p>
  <h1>Consistencia club-jugador</h1>
  <p class="lede">
    ¿La <strong>calidad individual agregada</strong> de un plantel (mediana del índice GLOBAL de sus jugadores con
    muestra suficiente) va en línea con lo que ese club <strong>efectivamente rinde en la tabla</strong>? Un desvío
    grande no es necesariamente un error: puede ser una defensa que rinde por ganar pocos duelos porque el rival casi
    no la pisa, un plantel con mejores individualidades que resultado colectivo, o directamente ruido de muestra.
    <em>Para el detalle jugador por jugador, entrá a Jugadores.</em>
  </p>

  {referenceTable ? (
    <>
      {!referenceTable.complete && (
        <div class="callout warning">
          <h3>Tabla de referencia incompleta</h3>
          <p>
            Ningún torneo disputado todavía llega a los 10 partidos por club -- se usa <strong>{stageLabel}</strong>{" "}
            con sólo {referenceTable.minMatchesPerTeam} partidos jugados por el club con menos fecha. Con tan poca
            muestra, cualquier desvío que se vea acá puede ser pura casualidad de resultados cortos, no una señal
            real. Volvé a mirar esta página más avanzado el torneo.
          </p>
        </div>
      )}

      <section class="section">
        <div class="section-head">
          <h2>Puntos de tabla vs. mediana del índice GLOBAL</h2>
          <p>
            Cada punto es un club: <strong>{referenceTable.complete ? stageLabel : `${stageLabel} (en curso)`}</strong>{" "}
            en el eje horizontal, mediana del <strong>índice GLOBAL</strong> de sus jugadores con muestra suficiente
            (≥11 partidos, ≥600 minutos -- mismo criterio que el ranking de Jugadores) en el vertical. El tamaño del
            punto es la cantidad de jugadores que entraron en la mediana. Los clubes con mayor desvío quedan
            etiquetados.
          </p>
        </div>
        <div class="card">
          <ClubConsistencyScatter client:only="react" rows={consistency} crests={crests} />
        </div>
        <p style="font-size: 0.8rem; color: var(--text-muted); margin-top: 0.5rem;">
          Se usa <strong>{stageLabel}</strong> (no la tabla en vivo) como referencia: al arrancar un torneo la tabla
          real tiene 1-2 fechas jugadas, insuficiente para comparar contra un agregado de temporada. Este análisis
          recalcula la tabla directamente de los partidos jugados de cada torneo y toma el más reciente que ya tenga
          una cantidad razonable de fechas -- ver metodología para el detalle completo.
        </p>
      </section>
    </>
  ) : (
    <section class="section">
      <p style="color: var(--text-muted);">Todavía no hay partidos jugados cargados para calcular ninguna tabla.</p>
    </section>
  )}
</Base>
