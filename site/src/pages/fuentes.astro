---
import Base from "../layouts/Base.astro";
import { loadJson, type Meta, type SourceStatus, type ConfidenceLevel } from "../lib/data";

const meta = loadJson<Meta>("meta.json");

const CONF_BADGE: Record<ConfidenceLevel, string> = {
  alta: "status-ok",
  media: "status-pending",
  complementaria: "conf-secondary",
  derivada: "conf-derived",
};
const CONF_LABEL: Record<ConfidenceLevel, string> = {
  alta: "Confianza alta",
  media: "Confianza media",
  complementaria: "Complementaria",
  derivada: "Métrica derivada",
};

const TITLES: Record<string, string> = {
  physical_performance: "Rendimiento físico",
  tactical_2026: "Táctico por jugador (2026)",
  goal_events: "Goles y goleadores",
  tactical_context: "Contexto táctico histórico",
  squad_ages: "Planteles y edad",
  team_profile: "Ranking FIFA y campo base",
  derived_metrics: "Métricas derivadas",
};

const order = [
  "physical_performance",
  "tactical_2026",
  "goal_events",
  "tactical_context",
  "squad_ages",
  "team_profile",
  "derived_metrics",
] as const;

const sources = order
  .map((key) => ({ key, title: TITLES[key] ?? key, s: (meta.sources as Record<string, SourceStatus>)[key] }))
  .filter((c) => c.s);

const cv = meta.cross_verification;
const legend = meta.confidence_legend;
const fmtDate = (iso?: string) =>
  iso ? new Date(iso).toLocaleString("es-AR", { dateStyle: "medium", timeStyle: "short" }) : "—";
---

<Base
  title="Fuentes y verificabilidad"
  description="Registro completo de fuentes: proveedor oficial, licencia, cobertura, fecha de actualización, método de cálculo y nivel de confianza de cada dato."
>
  <p class="eyebrow">Cada dato, trazable a su origen</p>
  <h1>Fuentes y verificabilidad</h1>
  <p class="lede">
    Toda la plataforma se apoya en datos abiertos y verificables. Para cada tabla que ves en el sitio, acá figura de
    dónde viene, con qué licencia, cuánta cobertura real tiene, cuándo se actualizó por última vez, cómo se calcula y
    qué nivel de confianza le corresponde. Podés comprobar cada fuente en su origen oficial.
  </p>
  <p style="font-size: 0.9rem; color: var(--text-secondary);">
    Última generación automática: <strong>{fmtDate(meta.generated_at)}</strong> (GitHub Actions).
  </p>

  {cv && cv.matches_checked > 0 && (
    <section class="section">
      <div class="callout">
        <h3>Cruce de fuentes independiente</h3>
        <p style="margin-bottom: 0.6rem;">{cv.description}</p>
        <div class="stat-tiles">
          <div class="stat-tile">
            <span class="value">{cv.matches_matched}/{cv.matches_checked}</span>
            <span class="label">partidos que coinciden</span>
          </div>
          <div class="stat-tile">
            <span class="value">{cv.discrepancies}</span>
            <span class="label">discrepancias</span>
          </div>
        </div>
        <p style="margin-top: 0.75rem; margin-bottom: 0; font-size: 0.9rem; color: var(--text-secondary);">
          <strong>A:</strong> {cv.source_a} &nbsp;·&nbsp; <strong>B:</strong> {cv.source_b}
        </p>
      </div>
    </section>
  )}

  <section class="section">
    <h2>Registro de fuentes</h2>
    <div class="source-grid">
      {sources.map(({ key, title, s }) => {
        const conf = s.confidence ?? "media";
        const badgeCls = s.status === "ok" ? CONF_BADGE[conf] : "status-pending";
        const badgeText = s.status === "ok" ? CONF_LABEL[conf] : "Pendiente de carga";
        return (
          <article class="card source-card">
            <div class="source-head">
              <h3>{title}</h3>
              <span class={`badge ${badgeCls}`}><span class="dot"></span>{badgeText}</span>
            </div>
            <dl>
              <dt>Fuente</dt>
              <dd>
                {s.provider_url ? (
                  <a href={s.provider_url} target="_blank" rel="noreferrer">{s.provider}</a>
                ) : (
                  s.provider
                )}
              </dd>

              <dt>Qué aporta</dt>
              <dd>{s.coverage}</dd>

              <dt>Cobertura</dt>
              <dd>
                {s.coverage_detail ?? "—"}
                {typeof s.coverage_pct === "number" && (
                  <div class="progress-row" style="margin-top: 0.4rem;">
                    <div class="progress-track"><div class="progress-fill" style={`width:${s.coverage_pct}%`}></div></div>
                    <span class="progress-label">{s.coverage_pct}%</span>
                  </div>
                )}
              </dd>

              <dt>Actualizado</dt>
              <dd>{fmtDate(s.as_of)}</dd>

              <dt>Licencia</dt>
              <dd>
                {s.license_url ? (
                  <a href={s.license_url} target="_blank" rel="noreferrer">{s.license_short ?? s.license}</a>
                ) : (
                  s.license_short ?? s.license ?? "—"
                )}
              </dd>

              <dt>Método</dt>
              <dd>{s.method ?? "—"}</dd>

              {s.cross_checked_against && (
                <>
                  <dt>Verificado contra</dt>
                  <dd>{s.cross_checked_against}</dd>
                </>
              )}
            </dl>
          </article>
        );
      })}
    </div>
  </section>

  {legend && (
    <section class="section">
      <h2>Cómo leemos el nivel de confianza</h2>
      <p>
        No inventamos un puntaje: el nivel se deriva de dos señales reales y comprobables — si la fuente es oficial y
        cuánta cobertura tiene realmente cargada. Es deliberadamente conservador.
      </p>
      <div class="table-scroll">
        <table>
          <thead>
            <tr><th>Nivel</th><th>Qué significa</th></tr>
          </thead>
          <tbody>
            {(Object.keys(legend) as ConfidenceLevel[]).map((lvl) => (
              <tr>
                <td><span class={`badge ${CONF_BADGE[lvl]}`}><span class="dot"></span>{CONF_LABEL[lvl]}</span></td>
                <td>{legend[lvl]}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  )}

  <section class="section">
    <h2>Método de las métricas derivadas</h2>
    <p>
      Percentiles, z-scores y clusters de estilo no son datos crudos: los calcula este proyecto sobre las fuentes de
      arriba. La misma explicación aparece como pie de cada gráfico que los usa, para que nunca se lean como valor
      absoluto.
    </p>
    <ul>
      <li><strong>Percentil (0–100):</strong> se calcula dentro del propio conjunto cargado (y dentro de la misma temporada), no contra un ranking mundial completo.</li>
      <li><strong>Z-score:</strong> desvíos respecto de la media de la temporada; compara 2026 contra 2026, no contra 2018/2022.</li>
      <li><strong>Estilo de juego (clusters):</strong> k-means sobre 5 métricas tácticas estandarizadas. Es una heurística descriptiva para agrupar equipos parecidos, no una clasificación táctica validada.</li>
    </ul>
    <p style="font-size: 0.9rem; color: var(--text-secondary);">
      Los sesgos, variables de confusión y límites de tamaño de muestra están detallados en la
      <a href={`${import.meta.env.BASE_URL}metodologia/`}>metodología</a>.
    </p>
  </section>
</Base>

<style>
  .source-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1rem;
  }
  .source-card {
    display: flex;
    flex-direction: column;
  }
  .source-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 0.6rem;
    margin-bottom: 0.75rem;
  }
  .source-head h3 {
    margin: 0;
    font-size: 1.05rem;
  }
  .source-card dl {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.4rem 0.9rem;
    margin: 0;
    font-size: 0.9rem;
  }
  .source-card dt {
    font-weight: 600;
    color: var(--text-secondary);
    white-space: nowrap;
  }
  .source-card dd {
    margin: 0;
    overflow-wrap: anywhere;
  }
  .badge.conf-secondary {
    color: var(--text-secondary);
    background: var(--surface-2);
    border-color: var(--border);
  }
  .badge.conf-secondary .dot {
    background: var(--text-secondary);
  }
  .badge.conf-derived {
    color: color-mix(in srgb, var(--brand) 70%, var(--text-primary));
    background: color-mix(in srgb, var(--brand) 10%, var(--surface-2));
    border-color: color-mix(in srgb, var(--brand) 25%, var(--border));
  }
  .badge.conf-derived .dot {
    background: var(--brand);
  }
</style>
