---
import Base from "../layouts/Base.astro";
import DataStatusBanner from "../layouts/DataStatusBanner.astro";
import { loadJson, loadCrestMap, type MatchSummary } from "../lib/data";
import TeamBadge from "../components/TeamBadge.astro";

const base = import.meta.env.BASE_URL;

function loadArray<T>(filename: string): T[] {
  const raw = loadJson<T[] | { status: string; rows: [] }>(filename);
  return Array.isArray(raw) ? raw : [];
}
const matches = loadArray<MatchSummary>("match_summaries.json");
const crests = loadCrestMap();

// Filas de comparación cara a cara: valor de cada equipo + su cuota del total
// (barra), para leer en un vistazo quién dominó cada faceta. Se omite la fila si
// falta el dato en alguno de los dos equipos.
type Row = { label: string; hv: string; av: string; hpct: number; unit: string };
function rows(m: MatchSummary): Row[] {
  const defs: { label: string; key: keyof MatchSummary["home"]; unit: string; digits: number }[] = [
    { label: "Posesión", key: "posesion_pct", unit: "%", digits: 0 },
    { label: "Remates", key: "remates", unit: "", digits: 0 },
    { label: "Remates al arco", key: "remates_al_arco", unit: "", digits: 0 },
    { label: "Pases", key: "pases", unit: "", digits: 0 },
    { label: "Precisión de pase", key: "precision_pases_pct", unit: "%", digits: 0 },
    { label: "Córners", key: "corners", unit: "", digits: 0 },
    { label: "Faltas", key: "faltas", unit: "", digits: 0 },
    { label: "Offsides", key: "offsides", unit: "", digits: 0 },
    { label: "Atajadas", key: "atajadas", unit: "", digits: 0 },
  ];
  const out: Row[] = [];
  for (const d of defs) {
    const h = m.home[d.key] as number | null;
    const a = m.away[d.key] as number | null;
    if (h == null || a == null) continue;
    const total = h + a;
    const fmt = (v: number) => `${Number(v.toFixed(d.digits))}${d.unit}`;
    out.push({ label: d.label, hv: fmt(h), av: fmt(a), hpct: total > 0 ? (h / total) * 100 : 50, unit: d.unit });
  }
  return out;
}

function goalsByTeam(m: MatchSummary, team: string) {
  return m.goleadores
    .filter((g) => g.team === team)
    .map((g) => `${g.player} ${g.minute}'${g.penalty ? " (p)" : ""}`)
    .join(", ");
}
const stageLabel = (s: string) => s || "Fase de grupos";

// Texto normalizado (sin acentos) para el buscador -> selecciones, fase y fecha.
const norm = (s: string) =>
  s
    .toLowerCase()
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "");
const searchText = (m: MatchSummary) => norm(`${m.home_team} ${m.away_team} ${stageLabel(m.stage)} ${m.match_date}`);
---

<Base title="Partidos" description="Resumen de cada partido de la Liga Profesional Argentina: resultado, goles, estadística de equipo y una lectura automática, con datos reales de ESPN.">
  <DataStatusBanner />
  <p class="eyebrow">Partido por partido · Liga Profesional</p>
  <h1>Partidos</h1>
  <p class="lede">
    Cada partido jugado, resumido para entenderlo en <strong>30 segundos</strong>: resultado, goles, quién manejó más
    la pelota y remató más, y una lectura automática — todo con datos reales de ESPN. <em>Nota: no mostramos xG
    (ninguna fuente libre lo publica para esta liga); usamos remates como proxy de peligro.</em>
  </p>

  {matches.length === 0 ? (
    <p class="card" style="color: var(--text-muted)">Todavía no hay partidos con datos cargados.</p>
  ) : (
    <>
    <div class="match-search-bar">
      <input
        type="search"
        id="match-search"
        class="match-search"
        placeholder="Buscar club o fase… (ej. Boca, cuartos)"
        autocomplete="off"
        aria-label="Buscar partidos"
      />
      <span class="match-count" id="match-count">{matches.length} partidos</span>
    </div>
    <p class="match-empty" id="match-empty" hidden>No hay partidos que coincidan con la búsqueda.</p>
    <div class="match-grid" id="match-grid">
      {matches.map((m) => {
        const homeWin = m.home_score > m.away_score;
        const awayWin = m.away_score > m.home_score;
        const hg = goalsByTeam(m, m.home_team);
        const ag = goalsByTeam(m, m.away_team);
        return (
          <article class="card match-card" data-search={searchText(m)}>
            <div class="mc-head">
              <span class="mc-stage">{stageLabel(m.stage)}</span>
              <span class="mc-date">{m.match_date}</span>
            </div>

            <div class="mc-score">
              <div class={`mc-team ${homeWin ? "win" : ""}`}>
                <TeamBadge team={m.home_team} crestUrl={crests[m.home_team]} class="mc-flag" />
                <span class="mc-name">{m.home_team}</span>
              </div>
              <div class="mc-result">
                <strong>{m.home_score}</strong><span>–</span><strong>{m.away_score}</strong>
              </div>
              <div class={`mc-team mc-team-r ${awayWin ? "win" : ""}`}>
                <span class="mc-name">{m.away_team}</span>
                <TeamBadge team={m.away_team} crestUrl={crests[m.away_team]} class="mc-flag" />
              </div>
            </div>

            {(hg || ag) && (
              <div class="mc-goals">
                <span>{hg || "—"}</span>
                <span class="mc-ball" aria-hidden="true">⚽</span>
                <span>{ag || "—"}</span>
              </div>
            )}

            <div class="mc-stats">
              {rows(m).map((r) => (
                <div class="mc-row">
                  <span class="mc-hv">{r.hv}</span>
                  <div class="mc-bar" title={r.label}>
                    <div class="mc-fill" style={`width:${r.hpct}%`}></div>
                  </div>
                  <span class="mc-label">{r.label}</span>
                  <span class="mc-av">{r.av}</span>
                </div>
              ))}
            </div>

            {m.destacado && (
              <div class="mc-mvp">
                <span aria-hidden="true">⭐</span> {m.destacado.player} <span class="mc-mvp-team">({m.destacado.team})</span>
                <span class="mc-mvp-note">· {m.destacado.note}</span>
              </div>
            )}

            {m.insight && <p class="mc-insight">{m.insight}</p>}

            <div class="mc-foot">
              <button type="button" class="btn btn-share btn-share-sm mc-share" data-mid={m.match_id}>📲 Compartir</button>
              <a class="mc-link" href={`${base}analisis/`}>Ver análisis →</a>
            </div>
          </article>
        );
      })}
    </div>
    <button type="button" class="btn btn-ghost match-load-more" id="match-load-more" hidden>
      Ver más partidos
    </button>
    </>
  )}

  <p style="font-size:0.8rem; color: var(--text-muted); margin-top: 1.5rem;">
    Estadística de equipo y goles: ESPN. Posesión = cuota de pases completados (proxy, no dato oficial de posesión).
    Remates = tiros intentados (proxy de peligro, <strong>no</strong> xG). El detalle de goleadores puede demorar en
    los partidos más recientes.
  </p>

  <script type="application/json" id="matches-json" set:html={JSON.stringify(matches)}></script>
  <script>
    import { shareMatch } from "../lib/shareMatch";
    const raw = document.getElementById("matches-json")?.textContent || "[]";
    const byId = new Map(JSON.parse(raw).map((m: any) => [String(m.match_id), m]));

    // Buscador + paginaci\u00f3n: las tarjetas ya vienen ordenadas de m\u00e1s reciente a
    // m\u00e1s vieja (ver build_aggregates.py) -- por defecto se muestran las
    // primeras PAGE_SIZE (el resto queda en el DOM pero oculto, "Ver m\u00e1s" las
    // revela de a tandas) para no forzar un scroll de 280+ tarjetas apenas se
    // entra a la p\u00e1gina. Buscar ignora la paginaci\u00f3n: una b\u00fasqueda recorre
    // TODAS las tarjetas, no s\u00f3lo la tanda visible.
    const PAGE_SIZE = 24;
    const input = document.getElementById("match-search") as HTMLInputElement | null;
    const cards = Array.from(document.querySelectorAll<HTMLElement>(".match-card"));
    const countEl = document.getElementById("match-count");
    const emptyEl = document.getElementById("match-empty");
    const loadMoreEl = document.getElementById("match-load-more") as HTMLButtonElement | null;
    const total = cards.length;
    let revealed = Math.min(PAGE_SIZE, total);

    function applyFilter() {
      const q = (input?.value || "").trim().toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "");
      let shown = 0;
      cards.forEach((c, i) => {
        const match = q ? (c.dataset.search || "").includes(q) : i < revealed;
        c.hidden = !match;
        if (match) shown++;
      });
      if (countEl) countEl.textContent = `${shown} de ${total} partidos`;
      if (emptyEl) emptyEl.hidden = shown !== 0;
      if (loadMoreEl) {
        const remaining = total - revealed;
        loadMoreEl.hidden = !!q || remaining <= 0;
        loadMoreEl.textContent = `Ver m\u00e1s partidos (${remaining} restantes)`;
      }
    }
    input?.addEventListener("input", applyFilter);
    loadMoreEl?.addEventListener("click", () => {
      revealed = Math.min(revealed + PAGE_SIZE, total);
      applyFilter();
    });
    // Estado inicial: SSR deja las 297 tarjetas visibles (fallback sin JS,
    // buscable por Ctrl+F) -- acá se aplica la paginación para quien sí tiene
    // JS, igual que hace applyFilter() con cada tecla del buscador.
    applyFilter();
    document.querySelectorAll<HTMLButtonElement>(".mc-share").forEach((btn) => {
      btn.addEventListener("click", async () => {
        const m = byId.get(btn.getAttribute("data-mid") || "");
        if (!m || btn.disabled) return;
        const orig = btn.textContent;
        btn.disabled = true;
        btn.textContent = "Generando…";
        try {
          const res = await shareMatch(m);
          btn.textContent = res === "downloaded" ? "Descargada ✓" : orig;
        } catch {
          btn.textContent = "No se pudo";
        } finally {
          window.setTimeout(() => {
            btn.textContent = orig;
            btn.disabled = false;
          }, 3000);
        }
      });
    });
  </script>
</Base>

<style>
  .match-search-bar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
    flex-wrap: wrap;
  }
  .match-search {
    flex: 1 1 260px;
    font-family: inherit;
    font-size: 0.95rem;
    padding: 0.7rem 1rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--surface-1);
    color: var(--text-primary);
  }
  .match-search:focus-visible {
    outline: 2px solid var(--brand);
    outline-offset: 1px;
    border-color: var(--brand);
  }
  .match-count {
    font-size: 0.82rem;
    color: var(--text-muted);
    font-weight: 600;
    white-space: nowrap;
  }
  .match-empty {
    color: var(--text-muted);
    padding: 1rem 0;
  }
  .match-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.25rem;
  }
  .match-card {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }
  /* el atributo [hidden] no alcanza porque .match-card fija display:flex;
     esta regla, más específica, lo tapa cuando el buscador oculta la tarjeta */
  .match-card[hidden] {
    display: none;
  }
  /* mismo problema que .match-card -- .btn fija display:inline-flex, así que
     el [hidden] nativo del botón "Ver más" no alcanza durante una búsqueda */
  .match-load-more[hidden] {
    display: none;
  }
  .match-load-more {
    margin: 1.5rem auto 0;
    display: flex;
  }
  .mc-head {
    display: flex;
    justify-content: space-between;
    font-size: 0.74rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-muted);
    font-weight: 700;
  }
  .mc-score {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 0.5rem;
  }
  .mc-team {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    min-width: 0;
    color: var(--text-secondary);
  }
  .mc-team.win {
    color: var(--text-primary);
  }
  .mc-team.win .mc-name {
    font-weight: 800;
  }
  .mc-team-r {
    justify-content: flex-end;
  }
  .mc-flag {
    font-size: 1.3rem;
    flex-shrink: 0;
  }
  .mc-name {
    font-size: 0.95rem;
    font-weight: 600;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .mc-result {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 1.4rem;
    font-family: var(--font-mono);
    letter-spacing: -0.02em;
  }
  .mc-result span {
    color: var(--text-muted);
  }
  .mc-goals {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 0.5rem;
    align-items: center;
    font-size: 0.8rem;
    color: var(--text-secondary);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    padding: 0.5rem 0;
  }
  .mc-goals span:last-child {
    text-align: right;
  }
  .mc-ball {
    opacity: 0.6;
  }
  .mc-stats {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .mc-row {
    display: grid;
    grid-template-columns: 3.2rem 1fr auto;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8rem;
  }
  .mc-hv {
    font-family: var(--font-mono);
    font-weight: 700;
    text-align: right;
    color: var(--text-primary);
  }
  .mc-av {
    font-family: var(--font-mono);
    font-weight: 700;
    color: var(--text-primary);
    min-width: 3.2rem;
  }
  .mc-label {
    grid-column: 2;
    grid-row: 1;
    justify-self: center;
    font-size: 0.72rem;
    color: var(--text-muted);
    pointer-events: none;
  }
  .mc-bar {
    grid-column: 2;
    grid-row: 1;
    height: 18px;
    border-radius: 5px;
    background: var(--series-1);
    opacity: 0.28;
    position: relative;
    overflow: hidden;
  }
  .mc-fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    background: var(--series-6);
    opacity: 0.62;
  }
  .mc-mvp {
    font-size: 0.85rem;
    color: var(--text-secondary);
  }
  .mc-mvp-team {
    color: var(--text-muted);
  }
  .mc-mvp-note {
    color: var(--text-muted);
  }
  .mc-insight {
    font-size: 0.85rem;
    color: var(--text-secondary);
    margin: 0;
    line-height: 1.45;
  }
  .mc-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin-top: auto;
    flex-wrap: wrap;
  }
  .mc-link {
    font-size: 0.82rem;
    font-weight: 600;
    text-decoration: none;
  }
</style>
